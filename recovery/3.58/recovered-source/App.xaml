<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="RadioApp.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:radioapp="clr-namespace:RadioApp;assembly=RadioApp">
  <Application.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F5FBFF" Offset="0" />
        <GradientStop Color="#DDEFFF" Offset="0.36" />
        <GradientStop Color="#F4F8FC" Offset="0.37" />
        <GradientStop Color="#EEF5FB" Offset="1" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="PanelBrush" Color="#F8FBFF" />
      <SolidColorBrush x:Key="PanelAltBrush" Color="#EEF6FD" />
      <SolidColorBrush x:Key="PrimaryBrush" Color="#0C4A6E" />
      <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0E7490" />
      <SolidColorBrush x:Key="AccentBrush" Color="#14B8A6" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#D5F6F1" />
      <SolidColorBrush x:Key="TextBrush" Color="#102030" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#486173" />
      <SolidColorBrush x:Key="BorderBrushSoft" Color="#A7D3E8" />
      <LinearGradientBrush x:Key="AeroButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#E8FBFF" Offset="0.48" />
        <GradientStop Color="#BEEFFF" Offset="0.5" />
        <GradientStop Color="#48CFF5" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AeroButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#E3FCFF" Offset="0.45" />
        <GradientStop Color="#6EEBFF" Offset="0.5" />
        <GradientStop Color="#008CFF" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AeroHeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FCFF" Offset="0" />
        <GradientStop Color="#C7EEFF" Offset="1" />
      </LinearGradientBrush>
      <Style x:Key="{x:Type Window}" TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
        <Setter Property="FontFamily" Value="Google Sans, Segoe UI" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      </Style>
      <Style x:Key="{x:Type Control}" TargetType="{x:Type Control}">
        <Setter Property="FontFamily" Value="Google Sans, Segoe UI" />
      </Style>
      <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Google Sans, Segoe UI" />
        <Setter Property="TextWrapping" Value="NoWrap" />
      </Style>
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12 5" />
        <Setter Property="Background" Value="{StaticResource AeroButtonBrush}" />
        <Setter Property="Foreground" Value="#111111" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Chrome" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4">
                <Border BorderBrush="#AFFFFFFF" BorderThickness="1" CornerRadius="3">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Control.Padding}" />
                </Border>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Background" Value="{StaticResource AeroButtonHoverBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Property="Background" Value="#7ADCF6" />
                  <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="UIElement.Opacity" Value="0.45" />
                  <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
      </Style>
      <Style x:Key="{x:Type Menu}" TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="{StaticResource AeroHeaderBrush}" />
        <Setter Property="BorderBrush" Value="#808080" />
        <Setter Property="BorderThickness" Value="0 0 0 1" />
      </Style>
      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8 4" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="6 3" />
      </Style>
      <Style x:Key="{x:Type GroupBox}" TargetType="{x:Type GroupBox}">
        <Setter Property="Padding" Value="10" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="Margin" Value="0 0 0 12" />
      </Style>
      <Style x:Key="{x:Type TabControl}" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      </Style>
      <Style x:Key="{x:Type DataGrid}" TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="DataGrid.GridLinesVisibility" Value="Horizontal" />
        <Setter Property="DataGrid.HorizontalGridLinesBrush" Value="#D7E5EF" />
        <Setter Property="DataGrid.RowHeight" Value="30" />
        <Setter Property="DataGrid.HeadersVisibility" Value="Column" />
        <Setter Property="DataGrid.AlternatingRowBackground" Value="#F0FBFF" />
        <Setter Property="DataGrid.RowHeaderWidth" Value="0" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      </Style>
      <Style x:Key="{x:Type DataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{StaticResource AeroHeaderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8 6" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="TextBlock.TextWrapping" Value="NoWrap" />
      </Style>
      <Style x:Key="{x:Type DataGridCell}" TargetType="{x:Type DataGridCell}">
        <Setter Property="TextBlock.TextWrapping" Value="NoWrap" />
        <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style x:Key="PanelBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="6" />
        <Setter Property="Border.Padding" Value="14" />
        <Setter Property="UIElement.Effect">
          <Setter.Value>
            <DropShadowEffect Color="#0C4A6E" BlurRadius="10" ShadowDepth="2" Opacity="0.12" />
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
