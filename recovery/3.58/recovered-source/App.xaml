<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="RadioApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:radioapp="clr-namespace:RadioApp;assembly=RadioApp"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

      <!-- Studio Dark Theme Palette -->
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0F17" />
      <SolidColorBrush x:Key="PanelBrush" Color="#111827" />
      <SolidColorBrush x:Key="PanelAltBrush" Color="#161F30" />
      <SolidColorBrush x:Key="PanelCardBrush" Color="#1A2438" />
      <SolidColorBrush x:Key="PanelCardHoverBrush" Color="#22304A" />

      <SolidColorBrush x:Key="TextBrush" Color="#F9FAFB" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#D1D5DB" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA3AF" />
      <SolidColorBrush x:Key="SubtleTextBrush" Color="#6B7280" />

      <!-- Accents & LED Indicators -->
      <SolidColorBrush x:Key="PrimaryBrush" Color="#0284C7" />
      <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0EA5E9" />
      <SolidColorBrush x:Key="PrimaryGlowBrush" Color="#38BDF8" />
      
      <SolidColorBrush x:Key="AccentBrush" Color="#06B6D4" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#164E63" />

      <SolidColorBrush x:Key="LiveGreenBrush" Color="#10B981" />
      <SolidColorBrush x:Key="LiveGreenSoftBrush" Color="#064E3B" />
      <SolidColorBrush x:Key="LiveGreenGlowBrush" Color="#34D399" />

      <SolidColorBrush x:Key="WarningAmberBrush" Color="#F59E0B" />
      <SolidColorBrush x:Key="WarningAmberSoftBrush" Color="#78350F" />

      <SolidColorBrush x:Key="DangerRedBrush" Color="#EF4444" />
      <SolidColorBrush x:Key="DangerRedSoftBrush" Color="#7F1D1D" />

      <SolidColorBrush x:Key="PurpleCartBrush" Color="#8B5CF6" />
      <SolidColorBrush x:Key="PurpleCartSoftBrush" Color="#4C1D95" />

      <!-- Borders & Dividers -->
      <SolidColorBrush x:Key="BorderBrushSoft" Color="#1F2937" />
      <SolidColorBrush x:Key="BorderBrushMedium" Color="#374151" />
      <SolidColorBrush x:Key="BorderBrushBright" Color="#4B5563" />
      <SolidColorBrush x:Key="BorderBrushFocus" Color="#0284C7" />

      <!-- Gradients -->
      <LinearGradientBrush x:Key="DeckAGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#082F49" Offset="0" />
        <GradientStop Color="#0F172A" Offset="0.5" />
        <GradientStop Color="#0284C7" Offset="1" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="DeckBGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#451A03" Offset="0" />
        <GradientStop Color="#0F172A" Offset="0.5" />
        <GradientStop Color="#D97706" Offset="1" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="OnAirLiveGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#DC2626" Offset="0" />
        <GradientStop Color="#EF4444" Offset="1" />
      </LinearGradientBrush>

      <!-- Global Window Style -->
      <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Roboto, Arial" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
      </Style>

      <Style TargetType="{x:Type Control}">
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Roboto, Arial" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      </Style>

      <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Roboto, Arial" />
        <Setter Property="TextWrapping" Value="NoWrap" />
      </Style>

      <!-- Standard Studio Button -->
      <Style TargetType="{x:Type Button}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14 6" />
        <Setter Property="Background" Value="{StaticResource PanelCardBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushMedium}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="BorderRoot"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6"
                      SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}"
                                  RecognizesAccessKey="True" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="BorderRoot" Property="Background" Value="{StaticResource PanelCardHoverBrush}" />
                  <Setter TargetName="BorderRoot" Property="BorderBrush" Value="{StaticResource PrimaryGlowBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="BorderRoot" Property="Background" Value="{StaticResource PrimaryBrush}" />
                  <Setter TargetName="BorderRoot" Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.4" />
                  <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Primary Accent Button -->
      <Style x:Key="PrimaryActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryGlowBrush}" />
      </Style>

      <!-- Live / On-Air Button Style -->
      <Style x:Key="LiveActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource LiveGreenBrush}" />
        <Setter Property="Foreground" Value="#042F1A" />
        <Setter Property="BorderBrush" Value="{StaticResource LiveGreenGlowBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
      </Style>

      <!-- Danger / Eject / Stop Button Style -->
      <Style x:Key="DangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource DangerRedSoftBrush}" />
        <Setter Property="Foreground" Value="#FECACA" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerRedBrush}" />
      </Style>

      <!-- Secondary Neutral Button -->
      <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
      </Style>

      <!-- Cart Pad Button Style -->
      <Style x:Key="CartPadButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource PanelCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PurpleCartBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="MinHeight" Value="60" />
      </Style>

      <!-- Menu Bar -->
      <Style TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="0 0 0 1" />
        <Setter Property="Padding" Value="6 3" />
      </Style>

      <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="Padding" Value="8 4" />
      </Style>

      <!-- Modern TextBox -->
      <Style TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8 4" />
        <Setter Property="Background" Value="{StaticResource PanelCardBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource PrimaryGlowBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushMedium}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Border Name="BorderRoot"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6">
                <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="BorderRoot" Property="BorderBrush" Value="{StaticResource BorderBrushBright}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="BorderRoot" Property="BorderBrush" Value="{StaticResource PrimaryGlowBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ComboBox -->
      <Style TargetType="{x:Type ComboBox}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8 4" />
        <Setter Property="Background" Value="{StaticResource PanelCardBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushMedium}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>

      <!-- GroupBox -->
      <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Padding" Value="12" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushMedium}" />
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0 0 0 12" />
      </Style>

      <!-- High-Performance Virtualized DataGrid -->
      <Style TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="RowHeight" Value="34" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource PanelAltBrush}" />
        <Setter Property="RowBackground" Value="{StaticResource PanelBrush}" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      </Style>

      <Style TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource PanelCardHoverBrush}" />
          </Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10 8" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="0 0 1 1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>

      <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="Padding" Value="8 0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type DataGridCell}">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="0"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Panel Border Studio Card -->
      <Style x:Key="PanelBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
      </Style>

      <!-- Modern Flat Slider -->
      <Style TargetType="{x:Type Slider}">
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryGlowBrush}" />
        <Setter Property="Background" Value="{StaticResource BorderBrushSoft}" />
      </Style>

      <!-- Section Title & Labels -->
      <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      </Style>

      <Style x:Key="LabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0 0 8 0" />
      </Style>

      <Style x:Key="TinyStatusStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <!-- Icon Font Glyph -->
      <Style x:Key="IconTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets, Segoe UI Symbol" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
