<Window x:Class="RadioApp.Views.ScheduleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:RadioApp.Models"
        Title="Edit Schedule Event — RadioApp Studio"
        Height="620" Width="680" MinHeight="560" MinWidth="600"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource AppBackgroundBrush}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1" CornerRadius="8" Padding="14 10" Margin="0 0 0 16">
      <StackPanel>
        <TextBlock Text="SCHEDULE EVENT CONFIGURATION" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryGlowBrush}" />
        <TextBlock Text="Configure timing, recurrence cadence, tolerances, and automation triggers"
                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0 2 0 0" />
      </StackPanel>
    </Border>

    <!-- Form Content Card -->
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1" CornerRadius="8" Padding="16">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- Title -->
          <Grid Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Event Title:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBox Grid.Column="1" Text="{Binding ScheduleItem.Title, Mode=TwoWay}" />
          </Grid>

          <!-- Event Type -->
          <Grid Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Event Type:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
            <ComboBox Grid.Column="1" Name="EventTypeComboBox" SelectedItem="{Binding ScheduleItem.EventType, Mode=TwoWay}" />
          </Grid>

          <!-- Target Deck -->
          <Grid Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Target Playout:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
            <ComboBox Grid.Column="1" Name="TargetDeckComboBox" SelectedItem="{Binding ScheduleItem.TargetDeck, Mode=TwoWay}" />
          </Grid>

          <!-- File / Folder Path -->
          <Grid Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Source Path:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBox Grid.Column="1" Text="{Binding ScheduleItem.FilePath, Mode=TwoWay}" />
            <Button Grid.Column="2" Content="File..." Style="{StaticResource SecondaryButtonStyle}" Width="70" Margin="8 0 0 0" Click="BrowseFile_Click" />
            <Button Grid.Column="3" Content="Folder..." Style="{StaticResource SecondaryButtonStyle}" Width="74" Margin="6 0 0 0" Click="BrowseFolder_Click" />
          </Grid>

          <!-- Date & Time -->
          <Grid Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Schedule Date:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
            <DatePicker Grid.Column="1" SelectedDate="{Binding SelectedDate, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Text="Time (HH:mm):" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 8 0" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBox Grid.Column="3" Width="90" HorizontalAlignment="Left" Text="{Binding ScheduleTime, Mode=TwoWay}" />
          </Grid>

          <!-- Repeat Cadence -->
          <Grid Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Recurrence:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
            <ComboBox Grid.Column="1" Name="RepeatModeComboBox" SelectedItem="{Binding ScheduleItem.RepeatMode, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Text="Interval (min):" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 8 0" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBox Grid.Column="3" Width="90" HorizontalAlignment="Left" Text="{Binding RepeatMinutes, Mode=TwoWay}" />
          </Grid>

          <!-- Tolerances -->
          <Grid Margin="0 0 0 14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Timing Tolerance:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Grid.Column="1" Text="Early (min):" VerticalAlignment="Center" Margin="0 0 6 0" Foreground="{StaticResource MutedTextBrush}" />
            <TextBox Grid.Column="2" Text="{Binding ToleranceBeforeMinutes, Mode=TwoWay}" />
            <TextBlock Grid.Column="3" Text="Late (min):" VerticalAlignment="Center" Margin="14 0 6 0" Foreground="{StaticResource MutedTextBrush}" />
            <TextBox Grid.Column="4" Text="{Binding ToleranceAfterMinutes, Mode=TwoWay}" />
          </Grid>

          <Separator Background="{StaticResource BorderBrushSoft}" Margin="0 0 0 14" />

          <!-- Flags & Options -->
          <Grid Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Playout Priority:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <CheckBox Content="Main Program Priority Event" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" IsChecked="{Binding ScheduleItem.IsMain, Mode=TwoWay}" />
              <CheckBox Content="Enabled / Active" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="24 0 0 0" IsChecked="{Binding ScheduleItem.Enabled, Mode=TwoWay}" />
            </StackPanel>
          </Grid>

          <!-- Folder Source Block -->
          <Grid Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Folder Automation:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <CheckBox Content="Random playlist source" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" IsChecked="{Binding ScheduleItem.IsFolderSource, Mode=TwoWay}" />
              <TextBlock Text="Duration (min):" VerticalAlignment="Center" Margin="18 0 6 0" Foreground="{StaticResource MutedTextBrush}" />
              <TextBox Width="70" Text="{Binding BlockDurationMinutes, Mode=TwoWay}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Bottom Buttons -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 14 0 0">
      <Button Content="Save Changes" Style="{StaticResource PrimaryActionButtonStyle}" Width="120" Margin="0 0 8 0" Click="Save_Click" />
      <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="90" Click="Cancel_Click" />
    </StackPanel>
  </Grid>
</Window>