<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RadioApp.Views.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library Manager — RadioApp Studio" Height="780" Width="1320" MinHeight="600" MinWidth="940"
        Icon="../Assets/RadioAppIcon.ico"
        Background="{StaticResource AppBackgroundBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header & Summary HUD -->
    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1" CornerRadius="10" Padding="14 10" Margin="0 0 0 12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Background="#162235" CornerRadius="6" Padding="10 4" Margin="0 0 0 2">
            <TextBlock HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource PrimaryGlowBrush}" Text="{Binding Library.LibrarySummary}" />
          </Border>
          <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Text="{Binding Library.ImportStatus}" />
        </StackPanel>
        
        <ProgressBar DockPanel.Dock="Right" Width="120" Height="14" Margin="0 0 16 0" VerticalAlignment="Center"
                     Foreground="{StaticResource PrimaryGlowBrush}" Background="#1E293B"
                     IsIndeterminate="True"
                     Visibility="{Binding Library.IsImporting, Converter={StaticResource BoolToVisibilityConverter}}" />
        
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="AUDIO LIBRARY MANAGER" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryGlowBrush}" />
          </StackPanel>
          <TextBlock Text="Search, inspect, organize, batch-tag, and route audio tracks to on-air playout"
                     Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0 2 0 0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Search & Filter Controls -->
    <Grid Grid.Row="1" Margin="0 0 0 12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      
      <TextBox Grid.Column="0" Margin="0 0 8 0"
               ToolTip="Instant Search: Title, Artist, Album, Category, Tags, File Path"
               Text="{Binding Library.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
               
      <ComboBox Grid.Column="1" Margin="0 0 8 0"
                ItemsSource="{Binding Library.CategoryOptions}"
                SelectedItem="{Binding Library.SelectedCategory, Mode=TwoWay}" />
                
      <Button Grid.Column="2" Content="Clear Filter" Width="104"
              Style="{StaticResource SecondaryButtonStyle}"
              Command="{Binding Library.ClearFilterCommand}" />
    </Grid>

    <!-- Playout Routing & File Action Toolbar -->
    <DockPanel Grid.Row="2" Margin="0 0 0 12">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="⚡ Load to Deck" Style="{StaticResource LiveActionButtonStyle}" Width="120" Margin="8 0 0 0" Command="{Binding LoadSelectedToProgramCommand}" />
        <Button Content="➕ Add to Queue" Style="{StaticResource PrimaryActionButtonStyle}" Width="124" Margin="8 0 0 0" Command="{Binding EnqueueSelectedCommand}" />
        <Button Content="🗑 Delete" Width="82" Margin="8 0 0 0"
                Style="{StaticResource DangerButtonStyle}" Click="DeleteLibrarySelection_Click" />
      </StackPanel>
      
      <WrapPanel>
        <Button Content="Import Track..." Width="116" Margin="0 0 8 0" Command="{Binding Library.ImportTrackCommand}" />
        <Button Content="Import Folder..." Width="120" Margin="0 0 8 0" Command="{Binding Library.ImportFolderCommand}" />
        <Button Content="Refresh" Width="90" Margin="0 0 8 0"
                Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Library.RefreshCommand}" />
        <Button Content="Rescan Folders" Width="116"
                Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Library.RescanWatchedFoldersCommand}" />
      </WrapPanel>
    </DockPanel>

    <!-- Main High-Speed Virtualized DataGrid -->
    <Grid Grid.Row="3">
      <DataGrid Name="LibraryDataGrid"
                AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                SelectionMode="Extended" SelectionUnit="FullRow" FrozenColumnCount="2"
                ItemsSource="{Binding Library.ItemsView}"
                SelectedItem="{Binding Library.SelectedItem, Mode=TwoWay}"
                RowEditEnding="LibraryDataGrid_RowEditEnding"
                MouseDoubleClick="LibraryDataGrid_MouseDoubleClick">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Title" Width="220" Binding="{Binding Title, Mode=TwoWay}" />
          <DataGridTextColumn Header="Artist" Width="170" Binding="{Binding Artist, Mode=TwoWay}" />
          <DataGridTextColumn Header="Album" Width="160" Binding="{Binding Album, Mode=TwoWay}" />
          <DataGridTextColumn Header="Duration" Width="78" IsReadOnly="True" Binding="{Binding DurationText}" />
          <DataGridTextColumn Header="Category" Width="110" Binding="{Binding Category, Mode=TwoWay}" />
          <DataGridTextColumn Header="Tags" Width="140" Binding="{Binding Tags, Mode=TwoWay}" />
          <DataGridTextColumn Header="Status" Width="78" IsReadOnly="True" Binding="{Binding FileStatus}" />
          <DataGridTextColumn Header="File Name" Width="180" IsReadOnly="True" Binding="{Binding FileName}" />
          <DataGridTextColumn Header="Folder Path" Width="2*" IsReadOnly="True" Binding="{Binding FolderPath}" />
          <DataGridTextColumn Header="Date Added" Width="135" IsReadOnly="True" Binding="{Binding DateAddedText}" />
          <DataGridTextColumn Header="Intro Cue" Width="72" Binding="{Binding IntroCueText, Mode=TwoWay}" />
          <DataGridTextColumn Header="Outro Cue" Width="72" Binding="{Binding OutroCueText, Mode=TwoWay}" />
          <DataGridTextColumn Header="Last Played" Width="135" IsReadOnly="True" Binding="{Binding LastPlayedText}" />
          <DataGridTextColumn Header="Plays" Width="60" IsReadOnly="True" Binding="{Binding PlayCount}" />
        </DataGrid.Columns>
      </DataGrid>

      <!-- Empty State Overlay -->
      <Border Visibility="{Binding Library.EmptyStateVisibility}"
              IsHitTestVisible="False" Background="#E60B0F17" BorderBrush="{StaticResource BorderBrushSoft}"
              BorderThickness="1" CornerRadius="8">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="" Style="{StaticResource IconTextStyle}" FontSize="36" Foreground="{StaticResource PrimaryGlowBrush}" Margin="0 0 0 10" />
          <TextBlock Text="No tracks match the current filter" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Library.EmptyStateMessage}" Margin="0 6 0 0"
                     Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Bottom Selected Track Inspector Bar -->
    <Border Grid.Row="4" Margin="0 12 0 0" Padding="12 10"
            Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1" CornerRadius="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        
        <StackPanel Grid.Column="0">
          <TextBlock FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryGlowBrush}" Text="{Binding Library.SelectedItem.Title, TargetNullValue=No track selected}" />
          <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0 2 0 0"
                     ToolTip="{Binding Library.SelectedItem.FilePath}"
                     Text="{Binding Library.SelectedItem.FilePath, TargetNullValue=Select a track to inspect source file location}" />
        </StackPanel>
        
        <StackPanel Grid.Column="1" Margin="16 0 0 0">
          <TextBlock Text="{Binding Library.SelectedItem.Artist, StringFormat='Artist: {0}', TargetNullValue='Artist: —'}" FontSize="12" Foreground="{StaticResource TextBrush}" />
          <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0 2 0 0"
                     Text="{Binding Library.SelectedItem.Album, StringFormat='Album: {0}', TargetNullValue='Album: —'}" />
        </StackPanel>
        
        <Border Grid.Column="2" Background="#111827" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" Padding="10 4" Margin="16 0 0 0" VerticalAlignment="Center">
          <TextBlock FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}"
                     Text="{Binding Library.SelectedItem.DurationText, TargetNullValue='—:—'}" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
