<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RadioApp.Views.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library Manager" Height="760" Width="1280" MinHeight="580" MinWidth="920"
        Icon="../Assets/RadioAppIcon.ico">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Margin="0 0 0 10">
      <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding Library.LibrarySummary}" />
        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Text="{Binding Library.ImportStatus}" />
      </StackPanel>
      <ProgressBar DockPanel.Dock="Right" Width="120" Height="12" Margin="0 6 14 0"
                   IsIndeterminate="True"
                   Visibility="{Binding Library.IsImporting, Converter={StaticResource BoolToVisibilityConverter}}" />
      <StackPanel>
        <TextBlock Text="Library Manager" FontSize="24" FontWeight="Bold" />
        <TextBlock Text="Browse every audio asset, inspect its source, edit metadata, and send it to air"
                   Foreground="{StaticResource MutedTextBrush}" Margin="0 2 0 0" />
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1" Margin="0 0 0 10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="190" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Grid.Column="0" Margin="0 0 8 0"
               ToolTip="Search title, artist, album, category, tags, or file path"
               Text="{Binding Library.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <ComboBox Grid.Column="1" Margin="0 0 8 0"
                ItemsSource="{Binding Library.CategoryOptions}"
                SelectedItem="{Binding Library.SelectedCategory, Mode=TwoWay}" />
      <Button Grid.Column="2" Content="Clear Filters" Width="104"
              Style="{StaticResource SecondaryButtonStyle}"
              Command="{Binding Library.ClearFilterCommand}" />
    </Grid>

    <DockPanel Grid.Row="2" Margin="0 0 0 10">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="Load Now" Width="104" Margin="8 0 0 0" Command="{Binding LoadSelectedToProgramCommand}" />
        <Button Content="Add to Queue" Width="116" Margin="8 0 0 0" Command="{Binding EnqueueSelectedCommand}" />
        <Button Content="Delete" Width="82" Margin="8 0 0 0"
                Style="{StaticResource SecondaryButtonStyle}" Click="DeleteLibrarySelection_Click" />
      </StackPanel>
      <WrapPanel>
        <Button Content="Import Track" Width="112" Margin="0 0 8 0" Command="{Binding Library.ImportTrackCommand}" />
        <Button Content="Import Folder" Width="120" Margin="0 0 8 0" Command="{Binding Library.ImportFolderCommand}" />
        <Button Content="Refresh View" Width="106" Margin="0 0 8 0"
                Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Library.RefreshCommand}" />
        <Button Content="Scan Folders" Width="108"
                Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Library.RescanWatchedFoldersCommand}" />
      </WrapPanel>
    </DockPanel>

    <Grid Grid.Row="3">
      <DataGrid Name="LibraryDataGrid"
                AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                SelectionMode="Extended" SelectionUnit="FullRow" FrozenColumnCount="2"
                ItemsSource="{Binding Library.ItemsView}"
                SelectedItem="{Binding Library.SelectedItem, Mode=TwoWay}"
                RowEditEnding="LibraryDataGrid_RowEditEnding"
                MouseDoubleClick="LibraryDataGrid_MouseDoubleClick">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Title" Width="220" Binding="{Binding Title, Mode=TwoWay}" />
          <DataGridTextColumn Header="Artist" Width="170" Binding="{Binding Artist, Mode=TwoWay}" />
          <DataGridTextColumn Header="Album" Width="160" Binding="{Binding Album, Mode=TwoWay}" />
          <DataGridTextColumn Header="Duration" Width="82" IsReadOnly="True" Binding="{Binding DurationText}" />
          <DataGridTextColumn Header="Category" Width="110" Binding="{Binding Category, Mode=TwoWay}" />
          <DataGridTextColumn Header="Tags" Width="150" Binding="{Binding Tags, Mode=TwoWay}" />
          <DataGridTextColumn Header="Status" Width="82" IsReadOnly="True" Binding="{Binding FileStatus}" />
          <DataGridTextColumn Header="File" Width="180" IsReadOnly="True" Binding="{Binding FileName}" />
          <DataGridTextColumn Header="Folder / Source Path" Width="2*" IsReadOnly="True" Binding="{Binding FolderPath}" />
          <DataGridTextColumn Header="Added" Width="135" IsReadOnly="True" Binding="{Binding DateAddedText}" />
        </DataGrid.Columns>
      </DataGrid>
      <Border Visibility="{Binding Library.EmptyStateVisibility}"
              IsHitTestVisible="False" Background="#EFFFFFFF" BorderBrush="{StaticResource BorderBrushSoft}"
              BorderThickness="1" CornerRadius="4">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="No tracks to display" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Library.EmptyStateMessage}" Margin="0 6 0 0"
                     Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="4" Margin="0 10 0 0" Padding="10"
            Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1" CornerRadius="4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock FontWeight="SemiBold" Text="{Binding Library.SelectedItem.Title, TargetNullValue=No track selected}" />
          <TextBlock Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding Library.SelectedItem.FilePath}"
                     Text="{Binding Library.SelectedItem.FilePath, TargetNullValue=Select a track to inspect its source path}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="18 0 0 0">
          <TextBlock Text="{Binding Library.SelectedItem.Artist, StringFormat=Artist: {0}, TargetNullValue=Artist: —}" />
          <TextBlock Foreground="{StaticResource MutedTextBrush}"
                     Text="{Binding Library.SelectedItem.Album, StringFormat=Album: {0}, TargetNullValue=Album: —}" />
        </StackPanel>
        <TextBlock Grid.Column="2" Margin="18 0 0 0" VerticalAlignment="Center" FontWeight="SemiBold"
                   Text="{Binding Library.SelectedItem.DurationText, TargetNullValue=—}" />
      </Grid>
    </Border>
  </Grid>
</Window>
