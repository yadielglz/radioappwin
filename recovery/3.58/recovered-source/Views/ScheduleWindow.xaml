<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RadioApp.Views.ScheduleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="Schedule" Height="620" Width="980" MinHeight="480" MinWidth="780" Icon="../Assets/RadioAppIcon.ico" xmlns:views="clr-namespace:RadioApp.Views;assembly=RadioApp">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0 0 0 10">
      <StackPanel>
        <TextBlock Text="Schedule" FontSize="24" FontWeight="Bold" />
        <TextBlock Text="Timed playlist blocks, sweeps, and main program events" Foreground="{StaticResource MutedTextBrush}" Margin="0 2 0 0" />
      </StackPanel>
    </DockPanel>
    <WrapPanel Grid.Row="1" Margin="0 0 0 10">
      <Button Content="Add" Width="90" Margin="0 0 8 8" Command="{Binding Schedule.AddScheduleCommand}" />
      <Button Content="Edit" Width="90" Margin="0 0 8 8" Command="{Binding Schedule.EditScheduleCommand}" />
      <Button Content="Delete" Width="90" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 8" Command="{Binding Schedule.DeleteScheduleCommand}" />
      <Button Content="Refresh" Width="96" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 8" Command="{Binding Schedule.RefreshCommand}" />
    </WrapPanel>
    <DataGrid Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinColumnWidth="72" ItemsSource="{Binding Schedule.Items}" SelectedItem="{Binding Schedule.SelectedItem, Mode=TwoWay}">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Main" Width="58" Binding="{Binding IsMain}" />
        <DataGridCheckBoxColumn Header="On" Width="48" Binding="{Binding Enabled}" />
        <DataGridTextColumn Header="Time" Width="1.2*" Binding="{Binding ScheduledAt, StringFormat=g}" />
        <DataGridTextColumn Header="Type" Width="*" Binding="{Binding EventType}" />
        <DataGridTextColumn Header="Repeat" Width="*" Binding="{Binding RepeatMode}" />
        <DataGridTextColumn Header="Tol -" Width="58" Binding="{Binding ToleranceBeforeMinutes}" />
        <DataGridTextColumn Header="Tol +" Width="58" Binding="{Binding ToleranceAfterMinutes}" />
        <DataGridTextColumn Header="Block" Width="64" Binding="{Binding BlockDurationMinutes}" />
        <DataGridTextColumn Header="Title" Width="1.5*" Binding="{Binding Title}" />
        <DataGridTextColumn Header="Source" Width="2*" Binding="{Binding FilePath}" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Window>