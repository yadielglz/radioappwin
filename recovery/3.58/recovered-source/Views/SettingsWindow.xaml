<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RadioApp.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RadioApp.Models" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="Settings" Height="700" Width="860" MinHeight="600" MinWidth="760" Icon="../Assets/RadioAppIcon.ico" ResizeMode="CanResizeWithGrip" xmlns:views="clr-namespace:RadioApp.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0 0 0 12" />
      </Style>
      <Style x:Key="LabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0 0 8 0" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0 0 0 14">
      <Button DockPanel.Dock="Right" Content="Refresh Devices" Style="{StaticResource SecondaryButtonStyle}" Width="126" Command="{Binding RefreshAudioDevicesCommand}" />
      <StackPanel>
        <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" />
        <TextBlock Text="Startup, library sync, audio devices, and streaming" Foreground="{StaticResource MutedTextBrush}" Margin="0 2 0 0" />
      </StackPanel>
    </DockPanel>
    <TabControl Grid.Row="1">
      <TabItem Header="General">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <GroupBox Header="Startup">
              <StackPanel Margin="4">
                <CheckBox Content="Connect and publish the stream automatically when the app starts" Margin="0 0 0 10" IsChecked="{Binding AutoConnectStreamOnStartup, Mode=TwoWay}" />
                <CheckBox Content="Start minimized to tray" IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}" />
              </StackPanel>
            </GroupBox>
            <GroupBox Header="Tray Behavior">
              <StackPanel Margin="4">
                <CheckBox Content="Minimize to tray instead of leaving a taskbar window" Margin="0 0 0 10" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                <CheckBox Content="Close button sends the app to the tray until Exit is chosen" IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
              </StackPanel>
            </GroupBox>
            <Border Background="#F5F9FE" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="4" Padding="10">
              <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Use Exit from the File menu or the tray icon menu when you want to shut RadioApp down completely." />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Library">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="14">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <GroupBox Header="Background Refresh">
              <StackPanel Margin="4">
                <CheckBox Content="Watch imported folders and refresh the library automatically" Margin="0 0 0 10" IsChecked="{Binding Library.BackgroundRefreshEnabled, Mode=TwoWay}" />
                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding Library.ImportStatus}" />
              </StackPanel>
            </GroupBox>
            <WrapPanel Grid.Row="1" Margin="0 0 0 12">
              <Button Content="Add Folder" Width="110" Margin="0 0 8 8" Command="{Binding Library.AddWatchedFolderCommand}" />
              <Button Content="Remove Folder" Width="120" Margin="0 0 8 8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Library.RemoveWatchedFolderCommand}" />
              <Button Content="Rescan Now" Width="110" Margin="0 0 8 8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Library.RescanWatchedFoldersCommand}" />
            </WrapPanel>
            <ListBox Grid.Row="2" MinHeight="180" ItemsSource="{Binding Library.WatchedFolders}" SelectedItem="{Binding Library.SelectedWatchedFolder, Mode=TwoWay}" />
            <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0 12 0 0">
              <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Watched folders are scanned for adds, removals, renames, and metadata edits. Categories and custom tags already stored in RadioApp stay intact." />
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Automation">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <GroupBox Header="Auto DJ" Margin="0 0 0 12">
              <Grid Margin="4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
                  <CheckBox Content="Enable Auto DJ" Margin="0 0 0 10" IsChecked="{Binding AutoScheduleEnabled, Mode=TwoWay}" />
                  <CheckBox Content="Fill the current hour" Margin="0 0 0 10" IsChecked="{Binding AutoDjFillCurrentHour, Mode=TwoWay}" />
                  <CheckBox Content="Enable gapless handoff" IsChecked="{Binding GaplessPlaybackEnabled, Mode=TwoWay}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Queue depth" Style="{StaticResource LabelStyle}" Margin="0 14 12 0" />
                <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0 10 0 0">
                  <TextBox Width="58" Margin="0 0 8 0" Text="{Binding AutoDjQueueDepth, Mode=TwoWay}" />
                  <TextBlock Text="items/minutes target" Style="{StaticResource LabelStyle}" />
                </WrapPanel>
              </Grid>
            </GroupBox>
            <GroupBox Header="Jingle / Sweeper Injection" Margin="0 0 0 12">
              <Grid Margin="4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0 0 0 10">
                  <CheckBox Content="Enabled" Margin="0 7 12 8" IsChecked="{Binding SweepersEnabled, Mode=TwoWay}" />
                  <Button Content="Choose Folder" Width="118" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 8" Command="{Binding SelectSweeperFolderCommand}" />
                </WrapPanel>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Folder" Style="{StaticResource LabelStyle}" Margin="0 0 12 10" />
                <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0 0 0 10" Text="{Binding SweeperFolder, Mode=TwoWay}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Frequency" Style="{StaticResource LabelStyle}" Margin="0 0 12 0" />
                <WrapPanel Grid.Row="2" Grid.Column="1">
                  <TextBlock Text="Every" Style="{StaticResource LabelStyle}" Margin="0 0 6 0" />
                  <TextBox Width="42" Margin="0 0 6 0" Text="{Binding SweeperMinSongs, Mode=TwoWay}" />
                  <TextBlock Text="to" Style="{StaticResource LabelStyle}" Margin="0 0 6 0" />
                  <TextBox Width="42" Margin="0 0 6 0" Text="{Binding SweeperMaxSongs, Mode=TwoWay}" />
                  <TextBlock Text="songs" Style="{StaticResource LabelStyle}" />
                </WrapPanel>
              </Grid>
            </GroupBox>
            <GroupBox Header="Radio ID Injection" Margin="0 0 0 12">
              <Grid Margin="4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0 0 0 10">
                  <CheckBox Content="Enabled" Margin="0 7 12 8" IsChecked="{Binding RadioIdsEnabled, Mode=TwoWay}" />
                  <Button Content="Choose Folder" Width="118" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 8" Command="{Binding SelectRadioIdFolderCommand}" />
                </WrapPanel>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Folder" Style="{StaticResource LabelStyle}" Margin="0 0 12 10" />
                <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0 0 0 10" Text="{Binding RadioIdFolder, Mode=TwoWay}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Timing" Style="{StaticResource LabelStyle}" Margin="0 0 12 0" />
                <WrapPanel Grid.Row="2" Grid.Column="1">
                  <TextBlock Text="Minute" Style="{StaticResource LabelStyle}" Margin="0 0 6 0" />
                  <TextBox Width="42" Margin="0 0 12 0" Text="{Binding RadioIdMinute, Mode=TwoWay}" />
                  <TextBlock Text="Tolerance -" Style="{StaticResource LabelStyle}" Margin="0 0 6 0" />
                  <TextBox Width="42" Margin="0 0 6 0" Text="{Binding RadioIdToleranceBeforeMinutes, Mode=TwoWay}" />
                  <TextBlock Text="+" Style="{StaticResource LabelStyle}" Margin="0 0 6 0" />
                  <TextBox Width="42" Margin="0 0 6 0" Text="{Binding RadioIdToleranceAfterMinutes, Mode=TwoWay}" />
                  <TextBlock Text="min" Style="{StaticResource LabelStyle}" />
                </WrapPanel>
              </Grid>
            </GroupBox>
            <GroupBox Header="Tag Rotation Rules">
              <Grid Margin="4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Default tag" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                <TextBox Grid.Row="1" Margin="0 0 0 10" Text="{Binding AutoDjDefaultTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Text="Hourly overrides, one per line: 18-19=live" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                <TextBox Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" Height="120" VerticalScrollBarVisibility="Auto" Text="{Binding AutoDjHourlyTagRules, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Audio">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="14">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <GroupBox Header="Devices" Margin="0 0 0 12">
              <Grid Margin="4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Program output" Style="{StaticResource LabelStyle}" Margin="0 0 12 10" />
                <ComboBox Grid.Row="0" Grid.Column="1" DisplayMemberPath="DisplayName" SelectedValuePath="DeviceNumber" Margin="0 0 0 10" ItemsSource="{Binding OutputAudioDevices}" SelectedValue="{Binding SelectedOutputDeviceNumber, Mode=TwoWay}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Recording input" Style="{StaticResource LabelStyle}" Margin="0 0 12 0" />
                <ComboBox Grid.Row="1" Grid.Column="1" DisplayMemberPath="DisplayName" SelectedValuePath="DeviceNumber" ItemsSource="{Binding InputAudioDevices}" SelectedValue="{Binding SelectedInputDeviceNumber, Mode=TwoWay}" />
              </Grid>
            </GroupBox>
            <GroupBox Grid.Row="1" Header="Audio Normalization" Margin="0 0 0 12">
              <Grid Margin="4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="68" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Row="0" Grid.ColumnSpan="3" Content="Enable adaptive loudness normalization" Margin="0 0 0 12" IsChecked="{Binding AudioNormalizationEnabled, Mode=TwoWay}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Target peak" Style="{StaticResource LabelStyle}" Margin="0 0 12 10" />
                <Slider Grid.Row="1" Grid.Column="1" Minimum="-24" Maximum="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0 0 10 10" Value="{Binding NormalizationTargetDb, Mode=TwoWay}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelStyle}" Margin="0 0 0 10" Text="{Binding NormalizationTargetDb, StringFormat={}{0:0} dB}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Maximum gain" Style="{StaticResource LabelStyle}" Margin="0 0 12 10" />
                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0 0 10 10" Value="{Binding NormalizationMaxGainDb, Mode=TwoWay}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource LabelStyle}" Margin="0 0 0 10" Text="{Binding NormalizationMaxGainDb, StringFormat={}{0:0} dB}" />
                <CheckBox Grid.Row="3" Grid.ColumnSpan="3" Content="Enable safety limiter" IsChecked="{Binding AudioLimiterEnabled, Mode=TwoWay}" />
              </Grid>
            </GroupBox>
            <GroupBox Grid.Row="2" Header="Radio Segue" Margin="0 0 0 12">
              <Grid Margin="4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="78" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Trigger level" Style="{StaticResource LabelStyle}" Margin="0 0 12 10" />
                <Slider Grid.Row="0" Grid.Column="1" Minimum="-72" Maximum="-12" TickFrequency="3" IsSnapToTickEnabled="True" Margin="0 0 10 10" Value="{Binding GaplessSilenceThresholdDb, Mode=TwoWay}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelStyle}" Margin="0 0 0 10" Text="{Binding GaplessSilenceThresholdDb, StringFormat={}{0:0} dB}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Crossfade" Style="{StaticResource LabelStyle}" Margin="0 0 12 10" />
                <Slider Grid.Row="1" Grid.Column="1" Minimum="100" Maximum="3000" TickFrequency="50" IsSnapToTickEnabled="True" Margin="0 0 10 10" Value="{Binding GaplessSilenceHoldMilliseconds, Mode=TwoWay}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelStyle}" Margin="0 0 0 10" Text="{Binding GaplessSilenceHoldMilliseconds, StringFormat={}{0} ms}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Scan window" Style="{StaticResource LabelStyle}" Margin="0 0 12 0" />
                <Slider Grid.Row="2" Grid.Column="1" Minimum="3" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0 0 10 0" Value="{Binding GaplessScanWindowSeconds, Mode=TwoWay}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="{Binding GaplessScanWindowSeconds, StringFormat={}{0:0} sec}" />
              </Grid>
            </GroupBox>
            <Border Grid.Row="3" Background="#F5F9FE" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="4" Padding="10">
              <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Device changes apply the next time a track is loaded. Level-triggered gapless does not apply to station IDs; they play to completion." />
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Streaming">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="14">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Stream Publishing" Style="{StaticResource SectionTitleStyle}" />
            <UniformGrid Grid.Row="1" Columns="3" Margin="0 0 0 12">
              <StackPanel Margin="0 0 10 0">
                <TextBlock Text="Server Type" Style="{StaticResource LabelStyle}" />
                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding StreamConfig.ServerType, Mode=TwoWay}">
                  <ComboBoxItem Content="SHOUTcast" Tag="{x:Static local:StreamServerType.Shoutcast}" />
                  <ComboBoxItem Content="Icecast" Tag="{x:Static local:StreamServerType.Icecast}" />
                </ComboBox>
              </StackPanel>
              <StackPanel Margin="0 0 10 0">
                <TextBlock Text="Server" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding StreamConfig.Host, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Port" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding StreamConfig.Port, Mode=TwoWay}" />
              </StackPanel>
            </UniformGrid>
            <UniformGrid Grid.Row="2" Columns="3" Margin="0 0 0 14">
              <StackPanel Margin="0 0 10 0">
                <TextBlock Text="Icecast Mount" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding StreamConfig.Mount, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Margin="0 0 10 0">
                <TextBlock Text="User" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding StreamConfig.Username, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Password / Stream Password" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding StreamConfig.Password, Mode=TwoWay}" />
              </StackPanel>
            </UniformGrid>
            <UniformGrid Grid.Row="3" Columns="3" Margin="0 0 0 14">
              <StackPanel Margin="0 0 10 0">
                <TextBlock Text="Bitrate" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding StreamConfig.Bitrate, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="SHOUTcast Stream ID (0 for v1)" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding StreamConfig.ShoutcastStreamId, Mode=TwoWay}" />
              </StackPanel>
            </UniformGrid>
            <WrapPanel Grid.Row="4" Margin="0 0 0 12">
              <Button Content="Connect" Width="105" Margin="0 0 8 8" Command="{Binding ConnectStreamCommand}" />
              <Button Content="Publish Program" Width="150" Margin="0 0 8 8" Command="{Binding StreamProgramCommand}" />
              <Button Content="Disconnect" Width="110" Margin="0 0 8 8" Command="{Binding DisconnectStreamCommand}" />
              <TextBlock Text="Saved automatically" Style="{StaticResource LabelStyle}" Margin="8 7 0 8" />
            </WrapPanel>
            <Border Grid.Row="5" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" Padding="10" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Text="Status" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" Margin="0 0 0 4" />
                <TextBlock Text="{Binding StreamStatus}" />
                <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0 8 0 0" Text="{Binding StreamEndpointText}" />
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Maintenance">
        <Grid Margin="14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="App Maintenance" Style="{StaticResource SectionTitleStyle}" />
          <WrapPanel Grid.Row="1" Margin="0 0 0 12">
            <Button Content="Clear Library" Width="120" Margin="0 0 8 8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearLibraryCommand}" />
            <Button Content="Reset App" Width="120" Margin="0 0 8 8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ResetAppCommand}" />
          </WrapPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
