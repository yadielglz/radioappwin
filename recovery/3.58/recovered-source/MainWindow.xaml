<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RadioApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="RadioApp" Icon="Assets/RadioAppIcon.ico" Height="820" Width="1280" MinHeight="620" MinWidth="900" xmlns:radioapp="clr-namespace:RadioApp;assembly=RadioApp">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0 0 0 8" />
      </Style>
      <Style x:Key="LabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0 0 8 0" />
      </Style>
      <Style x:Key="TinyStatusStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="IconTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0 0 8 8" />
      </Style>
      <Style x:Key="PlayerBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Border.CornerRadius" Value="11" />
        <Setter Property="Border.Padding" Value="12 6" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="#17324B" />
        <Setter Property="BorderBrush" Value="#2E6E96" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
      <Style x:Key="PlayerChipStyle" TargetType="{x:Type Border}">
        <Setter Property="Border.CornerRadius" Value="10" />
        <Setter Property="Border.Padding" Value="10 6" />
        <Setter Property="Margin" Value="0 0 8 8" />
        <Setter Property="Background" Value="#18344D" />
        <Setter Property="BorderBrush" Value="#29597D" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
      <Style x:Key="PlayerIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0 0 10 0" />
        <Setter Property="Background" Value="#E7F7FF" />
        <Setter Property="BorderBrush" Value="#8EDBFF" />
      </Style>
      <Style x:Key="PlayerActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="14 8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Margin" Value="0 0 10 0" />
        <Setter Property="Background" Value="#1AE0C5" />
        <Setter Property="BorderBrush" Value="#7EF3E2" />
        <Setter Property="Foreground" Value="#0F2230" />
      </Style>
      <Style x:Key="PlayerSecondaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="12 8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Margin" Value="0 0 8 0" />
        <Setter Property="Background" Value="#183554" />
        <Setter Property="BorderBrush" Value="#4B8EC0" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Import Track" Command="{Binding Library.ImportTrackCommand}" />
        <MenuItem Header="Import _Folder" Command="{Binding Library.ImportFolderCommand}" />
        <MenuItem Header="_Scan Library Now" Command="{Binding Library.RescanWatchedFoldersCommand}" />
        <MenuItem Header="_Library Window" Click="LibraryWindow_Click" />
        <MenuItem Header="_Schedule Window" Click="ScheduleWindow_Click" />
        <Separator />
        <MenuItem Header="E_xit" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Settings..." Click="Settings_Click" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About RadioApp" Click="About_Click" />
      </MenuItem>
    </Menu>
    <Grid Margin="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel Margin="0 0 0 12">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0 0 16 0">
          <Image Source="Assets/RadioAppLogo.png" Width="46" Height="46" Margin="0 0 12 0" RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="RadioApp" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock Text="Program player, queue, automation, and schedule management" Foreground="{StaticResource MutedTextBrush}" Margin="0 2 0 0" />
          </StackPanel>
        </StackPanel>
        <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12 8" VerticalAlignment="Center">
          <TextBlock Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding HeaderStatus}" />
        </Border>
      </DockPanel>
      <Grid Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.5*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid Column="0" Margin="0 0 12 0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Margin="0" CornerRadius="16" BorderThickness="1" BorderBrush="#2FA7D7" Padding="18">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1C2C" Offset="0" />
                <GradientStop Color="#113554" Offset="0.45" />
                <GradientStop Color="#165072" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid Row="0" Margin="0 0 0 14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Program Player" FontSize="13" FontWeight="SemiBold" Foreground="#8FD9FF" Margin="0 0 0 4" />
                  <TextBlock Text="Live playout deck with direct queue handoff" Foreground="#CAEFFF" FontSize="12" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource PlayerBadgeStyle}" Margin="12 0 0 0">
                  <TextBlock Foreground="#EAF7FF" FontSize="12" FontWeight="SemiBold" Text="{Binding ProgramPlayer.PlaybackStateText}" />
                </Border>
              </Grid>
              <Grid Row="1" Margin="0 0 0 16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0 0 20 0">
                  <TextBlock FontSize="31" FontWeight="Bold" Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis" Margin="0 0 0 6" Text="{Binding ProgramPlayer.TrackTitle}" />
                  <TextBlock Foreground="#D6F2FF" FontSize="16" TextTrimming="CharacterEllipsis" Margin="0 0 0 12" Text="{Binding ProgramPlayer.TrackArtist}" />
                  <WrapPanel>
                    <Border Style="{StaticResource PlayerChipStyle}">
                      <TextBlock Foreground="#D5EAF7" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="300" Text="{Binding ProgramPlayer.TrackAlbum, StringFormat=Album: {0}}" />
                    </Border>
                    <Border Style="{StaticResource PlayerChipStyle}">
                      <TextBlock Foreground="#D5EAF7" FontSize="12" Text="{Binding ProgramPlayer.PositionText}" />
                    </Border>
                    <Border Style="{StaticResource PlayerChipStyle}">
                      <TextBlock Text="Program Output" Foreground="#D5EAF7" FontSize="12" />
                    </Border>
                  </WrapPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#10283F" BorderBrush="#2E688F" BorderThickness="1" CornerRadius="14" Padding="16">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="On Air Deck" Foreground="#8FD9FF" FontSize="12" FontWeight="SemiBold" Margin="0 0 0 8" />
                    <TextBlock Foreground="#FFFFFFFF" FontSize="22" FontWeight="Bold" Margin="0 0 0 10" Text="{Binding ProgramPlayer.PlaybackStateText}" />
                    <TextBlock Text="Primary output path for live queue and automation" Foreground="#B8DCF0" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Grid.Row="2" Background="#0F2740" BorderBrush="#285E84" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0 0 0 14">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <WrapPanel VerticalAlignment="Center" Margin="0 0 18 0">
                    <Button ToolTip="Load track" Style="{StaticResource PlayerSecondaryButtonStyle}" Command="{Binding ProgramPlayer.LoadTrackCommand}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" Style="{StaticResource IconTextStyle}" Margin="0 0 6 0" />
                        <TextBlock Text="Load" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button ToolTip="Load random track" Style="{StaticResource PlayerSecondaryButtonStyle}" Command="{Binding RandomizeDeckACommand}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" Style="{StaticResource IconTextStyle}" Margin="0 0 6 0" />
                        <TextBlock Text="Random" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </WrapPanel>
                  <WrapPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button ToolTip="Play" Style="{StaticResource PlayerActionButtonStyle}" Command="{Binding ProgramPlayer.PlayCommand}">
                      <TextBlock Text="" Style="{StaticResource IconTextStyle}" Foreground="#0F2230" />
                    </Button>
                    <Button ToolTip="Pause" Style="{StaticResource PlayerIconButtonStyle}" Command="{Binding ProgramPlayer.PauseCommand}">
                      <TextBlock Text="" Style="{StaticResource IconTextStyle}" Foreground="#0F2230" />
                    </Button>
                    <Button ToolTip="Stop" Style="{StaticResource PlayerIconButtonStyle}" Command="{Binding ProgramPlayer.StopCommand}">
                      <TextBlock Text="" Style="{StaticResource IconTextStyle}" Foreground="#0F2230" />
                    </Button>
                    <Button ToolTip="Play next queued item" Style="{StaticResource PlayerIconButtonStyle}" Command="{Binding PlayNextCommand}">
                      <TextBlock Text="" Style="{StaticResource IconTextStyle}" Foreground="#0F2230" />
                    </Button>
                  </WrapPanel>
                  <Border Grid.Column="2" Background="#173756" BorderBrush="#3E7AA5" BorderThickness="1" CornerRadius="12" Padding="12 8" Margin="18 0 0 0">
                    <StackPanel>
                      <TextBlock Text="Queued Hand-off" Foreground="#8FD9FF" FontSize="11" FontWeight="SemiBold" />
                      <TextBlock Foreground="#FFFFFFFF" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="180" Text="{Binding NextQueueCue}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
              <Grid Row="3" Margin="0 0 0 10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0 0 0 6">
                  <TextBlock DockPanel.Dock="Right" Foreground="#D6F2FF" FontSize="12" Text="{Binding ProgramPlayer.PositionText}" />
                  <TextBlock Text="Playback Position" Foreground="#8FD9FF" FontSize="12" FontWeight="SemiBold" />
                </DockPanel>
                <Slider Grid.Row="1" Minimum="0" Maximum="100" Height="24" IsMoveToPointEnabled="True" ToolTip="Click or drag to skip within the current track" Value="{Binding ProgramPlayer.PlaybackProgress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>
              <Grid Row="4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <Border Background="#0F2740" BorderBrush="#285E84" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0 0 14 0">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0 0 0 8">
                      <TextBlock DockPanel.Dock="Right" Foreground="#D6F2FF" FontSize="12" Text="{Binding ProgramPlayer.Volume, StringFormat={}{0:P0}}" />
                      <TextBlock Text="Volume" Foreground="#8FD9FF" FontSize="12" FontWeight="SemiBold" />
                    </DockPanel>
                    <Slider Grid.Row="1" Minimum="0" Maximum="1" Value="{Binding ProgramPlayer.Volume, Mode=TwoWay}" />
                  </Grid>
                </Border>
                <Border Grid.Column="1" Background="#0F2740" BorderBrush="#285E84" BorderThickness="1" CornerRadius="14" Padding="14">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0 0 0 8">
                      <TextBlock DockPanel.Dock="Right" Foreground="#D6F2FF" FontSize="12" Text="{Binding ProgramPlayer.Tempo, StringFormat={}{0:0.00}x}" />
                      <TextBlock Text="Tempo" Foreground="#8FD9FF" FontSize="12" FontWeight="SemiBold" />
                    </DockPanel>
                    <WrapPanel Grid.Row="1">
                      <Button Content="1.00x" Width="88" Style="{StaticResource PlayerSecondaryButtonStyle}" Command="{Binding ProgramPlayer.NormalTempoCommand}" />
                      <Button Content="1.10x" Width="88" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 0" Command="{Binding ProgramPlayer.FastTempoCommand}" />
                    </WrapPanel>
                  </Grid>
                </Border>
              </Grid>
            </Grid>
          </Border>
        </Grid>
        <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0 0 0 8">
              <TextBlock DockPanel.Dock="Right" Style="{StaticResource TinyStatusStyle}" Text="{Binding QueueStatus}" />
              <TextBlock Text="Queue Manager" Style="{StaticResource SectionTitleStyle}" />
            </DockPanel>
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0 0 0 10">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="82" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="UP NEXT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0 0 8 5" />
                <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0 0 0 5" Text="{Binding NextQueueCue}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="ID" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0 0 8 5" />
                <TextBlock Grid.Row="1" Grid.Column="1" TextTrimming="CharacterEllipsis" Margin="0 0 0 5" Text="{Binding NextRadioIdCue}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="JINGLE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0 0 8 0" />
                <TextBlock Grid.Row="2" Grid.Column="1" TextTrimming="CharacterEllipsis" Margin="0 0 0 5" Text="{Binding NextSweeperCue}" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="RULE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0 0 8 0" />
                <TextBlock Grid.Row="3" Grid.Column="1" TextTrimming="CharacterEllipsis" Text="{Binding RotationCue}" />
              </Grid>
            </Border>
            <WrapPanel Grid.Row="2" Margin="0 0 0 10">
              <Button Content="Play Next" Width="96" Margin="0 0 8 8" Command="{Binding PlayNextCommand}" />
              <Button Content="Auto Pick" Width="90" Margin="0 0 8 8" Command="{Binding EnqueueRandomCommand}" />
              <Button Content="Remove" Width="82" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 8" Command="{Binding RemoveQueueItemCommand}" />
              <Button Content="Clear" Width="70" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 8" Command="{Binding ClearQueueCommand}" />
            </WrapPanel>
            <DataGrid Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinColumnWidth="72" ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedQueueItem, Mode=TwoWay}">
              <DataGrid.RowStyle>
                <Style TargetType="{x:Type DataGridRow}">
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding IsStationIdCue}">
                      <Setter Property="Background" Value="#EAF6FF" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Value="True" Binding="{Binding IsSweeperCue}">
                      <Setter Property="Background" Value="#FFF7D6" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Cue" Width="48">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border CornerRadius="3" Padding="4 1" HorizontalAlignment="Center" MinWidth="34">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type Border}">
                            <Setter Property="Background" Value="#00FFFFFF" />
                            <Setter Property="BorderBrush" Value="#00FFFFFF" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding IsStationIdCue}">
                                <Setter Property="Background" Value="#BFE5FF" />
                                <Setter Property="BorderBrush" Value="#5BA7D8" />
                              </DataTrigger>
                              <DataTrigger Value="True" Binding="{Binding IsSweeperCue}">
                                <Setter Property="Background" Value="#FFE89A" />
                                <Setter Property="BorderBrush" Value="#D6A900" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                        <TextBlock FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1F2933" Text="{Binding QueueCueLabel}" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Title" Width="2*" Binding="{Binding Title}" />
                <DataGridTextColumn Header="Category" Width="*" Binding="{Binding Category}" />
                <DataGridTextColumn Header="Duration" Width="*" Binding="{Binding Duration}" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>