<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RadioApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="RadioApp Studio — v26.1007.0900"
        Icon="Assets/RadioAppIcon.ico"
        Height="840" Width="1360"
        MinHeight="680" MinWidth="980"
        xmlns:radioapp="clr-namespace:RadioApp;assembly=RadioApp">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="OnAirBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14 6" />
        <Setter Property="Background" Value="{StaticResource LiveGreenSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LiveGreenBrush}" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>

      <Style x:Key="DeckCardBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryGlowBrush}" />
        <Setter Property="Background" Value="{StaticResource DeckAGradientBrush}" />
        <Setter Property="Padding" Value="20" />
      </Style>

      <Style x:Key="TimecodeBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12 6" />
        <Setter Property="Background" Value="#09131F" />
        <Setter Property="BorderBrush" Value="#1E3A5F" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>

  <DockPanel Background="{StaticResource AppBackgroundBrush}">
    <!-- Top Menu Bar -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Import Track..." Command="{Binding Library.ImportTrackCommand}" />
        <MenuItem Header="Import _Folder..." Command="{Binding Library.ImportFolderCommand}" />
        <MenuItem Header="_Rescan Library Now" Command="{Binding Library.RescanWatchedFoldersCommand}" />
        <Separator Background="{StaticResource BorderBrushSoft}" />
        <MenuItem Header="_Library Manager" Click="LibraryWindow_Click" />
        <MenuItem Header="_Schedule &amp; Automation" Click="ScheduleWindow_Click" />
        <Separator Background="{StaticResource BorderBrushSoft}" />
        <MenuItem Header="E_xit" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="_Control">
        <MenuItem Header="_Play Next" Command="{Binding PlayNextCommand}" />
        <MenuItem Header="_Auto-Pick Track" Command="{Binding EnqueueRandomCommand}" />
        <MenuItem Header="_Clear Queue" Command="{Binding ClearQueueCommand}" />
      </MenuItem>
      <MenuItem Header="_Options">
        <MenuItem Header="_Studio Settings..." Click="Settings_Click" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About RadioApp Studio" Click="About_Click" />
      </MenuItem>
    </Menu>

    <!-- Main Studio Console -->
    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Top Studio HUD Banner -->
      <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
              BorderThickness="1" CornerRadius="10" Padding="14 10" Margin="0 0 0 14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="Assets/RadioAppLogo.png" Width="40" Height="40" Margin="0 0 12 0" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="RADIOAPP STUDIO" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryGlowBrush}" />
                <Border Background="#1E293B" CornerRadius="4" Padding="6 1" Margin="8 0 0 0" VerticalAlignment="Center">
                  <TextBlock Text="v26.1007.0900" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                </Border>
              </StackPanel>
              <TextBlock Text="Broadcast Automation, Playout Engine &amp; Live Stream Console" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0 2 0 0" />
            </StackPanel>
          </StackPanel>

          <!-- Right Status HUD -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Stream Status Chip -->
            <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushMedium}" BorderThickness="1" CornerRadius="8" Padding="12 6" Margin="0 0 10 0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="" Style="{StaticResource IconTextStyle}" FontSize="14" Foreground="{StaticResource AccentBrush}" Margin="0 0 6 0" />
                <TextBlock Text="{Binding StreamStatus, StringFormat='Stream: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>

            <!-- Automation / Header Status Chip -->
            <Border Style="{StaticResource OnAirBadgeStyle}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" Style="{StaticResource IconTextStyle}" FontSize="13" Foreground="{StaticResource LiveGreenBrush}" Margin="0 0 6 0" />
                <TextBlock Foreground="{StaticResource LiveGreenGlowBrush}" FontWeight="Bold" FontSize="12" Text="{Binding HeaderStatus}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Central Split: Left Deck & Playout Console, Right Queue Manager -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.2*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Left Playout Decks & Controls -->
        <Grid Grid.Column="0" Margin="0 0 14 0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Main Program Deck (Deck A) -->
          <Border Grid.Row="0" Style="{StaticResource DeckCardBorderStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- Deck Header Bar -->
              <DockPanel Grid.Row="0" Margin="0 0 0 16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Background="{StaticResource PrimaryBrush}" CornerRadius="4" Padding="8 2" Margin="0 0 8 0">
                    <TextBlock Text="ON AIR DECK" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                  </Border>
                  <TextBlock Text="Primary Playout &amp; Transmission Master" Foreground="{StaticResource PrimaryGlowBrush}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

                <!-- State Badge -->
                <Border DockPanel.Dock="Right" Background="#0C233C" BorderBrush="{StaticResource PrimaryGlowBrush}" BorderThickness="1" CornerRadius="8" Padding="12 4">
                  <TextBlock Foreground="{StaticResource PrimaryGlowBrush}" FontSize="13" FontWeight="Bold" Text="{Binding ProgramPlayer.PlaybackStateText}" />
                </Border>
              </DockPanel>

              <!-- Track Metadata & Big Timecode Displays -->
              <Grid Grid.Row="1" Margin="0 0 0 16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>

                <!-- Metadata Column -->
                <StackPanel VerticalAlignment="Center" Margin="0 0 16 0">
                  <TextBlock FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0 0 0 6" Text="{Binding ProgramPlayer.TrackTitle}" />
                  <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryGlowBrush}" TextTrimming="CharacterEllipsis" Margin="0 0 0 12" Text="{Binding ProgramPlayer.TrackArtist}" />
                  
                  <WrapPanel>
                    <Border Background="#10253D" BorderBrush="#1F4770" BorderThickness="1" CornerRadius="6" Padding="10 4" Margin="0 0 8 8">
                      <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="280" Text="{Binding ProgramPlayer.TrackAlbum, StringFormat='Album: {0}'}" />
                    </Border>
                    <Border Background="#10253D" BorderBrush="#1F4770" BorderThickness="1" CornerRadius="6" Padding="10 4" Margin="0 0 8 8">
                      <TextBlock Text="44.1 kHz Stereo" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                  </WrapPanel>
                </StackPanel>

                <!-- Digital Timecode Studio Cards -->
                <Border Grid.Column="1" Background="#09131F" BorderBrush="#1D3A5F" BorderThickness="1" CornerRadius="10" Padding="14">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="TIME REMAINING" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0 0 0 4" />
                    <TextBlock Text="{Binding ProgramPlayer.RemainingFormatted}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource WarningAmberBrush}" HorizontalAlignment="Center" FontFamily="Consolas, Segoe UI" Margin="0 0 0 8" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                      <TextBlock Text="Elapsed: " FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                      <TextBlock Text="{Binding ProgramPlayer.ElapsedFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" FontFamily="Consolas, Segoe UI" />
                      <TextBlock Text=" / " FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                      <TextBlock Text="{Binding ProgramPlayer.TotalDurationFormatted}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas, Segoe UI" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- Waveform / Progress Slider -->
              <Grid Grid.Row="2" Margin="0 0 0 14">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0 0 0 6">
                  <TextBlock Text="TRACK PROGRESSION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                  <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource PrimaryGlowBrush}" Text="{Binding ProgramPlayer.PositionText}" />
                </DockPanel>
                <Slider Grid.Row="1" Minimum="0" Maximum="100" Height="26"
                        Value="{Binding ProgramPlayer.PlaybackProgress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Drag or click to scrub position" />
              </Grid>

              <!-- Playout Transport Control Bar -->
              <Border Grid.Row="3" Background="#09131F" BorderBrush="#1D3A5F" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0 0 0 14">
                <DockPanel>
                  <!-- Left File Controls -->
                  <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button ToolTip="Load Track File" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 6 0" Command="{Binding ProgramPlayer.LoadTrackCommand}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" Style="{StaticResource IconTextStyle}" FontSize="13" Margin="0 0 6 0" />
                        <TextBlock Text="Load" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button ToolTip="Load Random Track" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 6 0" Command="{Binding RandomizeDeckACommand}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" Style="{StaticResource IconTextStyle}" FontSize="13" Margin="0 0 6 0" />
                        <TextBlock Text="Random" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button ToolTip="Cue to Start" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 6 0" Command="{Binding ProgramPlayer.CueCommand}">
                      <TextBlock Text="CUE" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                    </Button>
                  </StackPanel>

                  <!-- Right Up-Next Indicator -->
                  <Border DockPanel.Dock="Right" Background="#10253D" BorderBrush="#1F4770" BorderThickness="1" CornerRadius="8" Padding="10 6" Margin="12 0 0 0">
                    <StackPanel>
                      <TextBlock Text="Cued Up Next" Foreground="{StaticResource PrimaryGlowBrush}" FontSize="10" FontWeight="Bold" />
                      <TextBlock Foreground="#FFFFFF" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="160" Text="{Binding NextQueueCue}" />
                    </StackPanel>
                  </Border>

                  <!-- Center Playout Buttons -->
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button ToolTip="Play Track" Style="{StaticResource LiveActionButtonStyle}" Width="60" Height="42" Margin="0 0 8 0" Command="{Binding ProgramPlayer.PlayCommand}">
                      <TextBlock Text="" Style="{StaticResource IconTextStyle}" FontSize="18" Foreground="#042F1A" />
                    </Button>
                    <Button ToolTip="Pause Track" Style="{StaticResource SecondaryButtonStyle}" Width="50" Height="42" Margin="0 0 8 0" Command="{Binding ProgramPlayer.PauseCommand}">
                      <TextBlock Text="" Style="{StaticResource IconTextStyle}" FontSize="16" />
                    </Button>
                    <Button ToolTip="Stop Playout" Style="{StaticResource DangerButtonStyle}" Width="50" Height="42" Margin="0 0 8 0" Command="{Binding ProgramPlayer.StopCommand}">
                      <TextBlock Text="" Style="{StaticResource IconTextStyle}" FontSize="15" />
                    </Button>
                    <Button ToolTip="Play Next in Queue" Style="{StaticResource PrimaryActionButtonStyle}" Width="50" Height="42" Margin="0 0 8 0" Command="{Binding PlayNextCommand}">
                      <TextBlock Text="" Style="{StaticResource IconTextStyle}" FontSize="16" />
                    </Button>
                  </StackPanel>
                </DockPanel>
              </Border>

              <!-- Bottom Level Faders & Tempo -->
              <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <!-- Volume Slider -->
                <Border Background="#09131F" BorderBrush="#1D3A5F" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0 0 10 0">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0 0 0 6">
                      <TextBlock Text="MASTER GAIN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                      <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource PrimaryGlowBrush}" FontSize="12" FontWeight="SemiBold" Text="{Binding ProgramPlayer.Volume, StringFormat='{}{0:P0}'}" />
                    </DockPanel>
                    <Slider Grid.Row="1" Minimum="0" Maximum="1" Value="{Binding ProgramPlayer.Volume, Mode=TwoWay}" />
                  </Grid>
                </Border>

                <!-- Tempo Control -->
                <Border Grid.Column="1" Background="#09131F" BorderBrush="#1D3A5F" BorderThickness="1" CornerRadius="10" Padding="12">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0 0 0 6">
                      <TextBlock Text="TEMPO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                      <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource PrimaryGlowBrush}" FontSize="12" FontWeight="SemiBold" Text="{Binding ProgramPlayer.Tempo, StringFormat='{}{0:0.00}x'}" />
                    </DockPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                      <Button Content="1.00x Normal" Style="{StaticResource SecondaryButtonStyle}" Width="110" Margin="0 0 8 0" Command="{Binding ProgramPlayer.NormalTempoCommand}" />
                      <Button Content="1.10x Fast" Style="{StaticResource SecondaryButtonStyle}" Width="100" Command="{Binding ProgramPlayer.FastTempoCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </Grid>
          </Border>

          <!-- Quick Playout Cartwall / Jingle Trigger Bar -->
          <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0 12 0 0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <DockPanel Margin="0 0 0 8">
                <TextBlock Text="QUICK CARTWALL &amp; STATION JINGLES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PurpleCartBrush}" />
                <TextBlock DockPanel.Dock="Right" Text="Instant sound trigger pads" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
              </DockPanel>
              <UniformGrid Grid.Row="1" Columns="4" Rows="1">
                <Button Content="⚡ STATION ID" Style="{StaticResource CartPadButtonStyle}" Margin="0 0 6 0" Command="{Binding PlayNextCommand}" />
                <Button Content="🎵 SWEEPER 1" Style="{StaticResource CartPadButtonStyle}" Margin="0 0 6 0" Command="{Binding RandomizeDeckACommand}" />
                <Button Content="🔥 JINGLE DROP" Style="{StaticResource CartPadButtonStyle}" Margin="0 0 6 0" Command="{Binding EnqueueRandomCommand}" />
                <Button Content="📢 PROMO SPOT" Style="{StaticResource CartPadButtonStyle}" Command="{Binding PlayNextCommand}" />
              </UniformGrid>
            </Grid>
          </Border>
        </Grid>

        <!-- Right Queue Manager Panel -->
        <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Queue Header -->
            <DockPanel Margin="0 0 0 10">
              <TextBlock Text="QUEUE MANAGER" Style="{StaticResource SectionTitleStyle}" />
              <TextBlock DockPanel.Dock="Right" Style="{StaticResource TinyStatusStyle}" Text="{Binding QueueStatus}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Automation & Rotation Status Card -->
            <Border Grid.Row="1" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0 0 0 10">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="UP NEXT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryGlowBrush}" Margin="0 0 6 4" />
                <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0 0 0 4" Text="{Binding NextQueueCue}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="STATION ID" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0 0 6 4" />
                <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0 0 0 4" Text="{Binding NextRadioIdCue}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="SWEEPER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningAmberBrush}" Margin="0 0 6 4" />
                <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0 0 0 4" Text="{Binding NextSweeperCue}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="ROTATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource LiveGreenGlowBrush}" Margin="0 0 6 0" />
                <TextBlock Grid.Row="3" Grid.Column="1" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding RotationCue}" />
              </Grid>
            </Border>

            <!-- Action Toolbar -->
            <WrapPanel Grid.Row="2" Margin="0 0 0 10">
              <Button Content="Play Next" Style="{StaticResource PrimaryActionButtonStyle}" Width="88" Margin="0 0 6 6" Command="{Binding PlayNextCommand}" />
              <Button Content="Auto Pick" Style="{StaticResource SecondaryButtonStyle}" Width="80" Margin="0 0 6 6" Command="{Binding EnqueueRandomCommand}" />
              <Button Content="Remove" Style="{StaticResource SecondaryButtonStyle}" Width="74" Margin="0 0 6 6" Command="{Binding RemoveQueueItemCommand}" />
              <Button Content="Clear All" Style="{StaticResource DangerButtonStyle}" Width="70" Margin="0 0 6 6" Command="{Binding ClearQueueCommand}" />
            </WrapPanel>

            <!-- Virtualized Queue DataGrid -->
            <DataGrid Grid.Row="3" ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedQueueItem, Mode=TwoWay}">
              <DataGrid.Columns>
                <!-- Cue Badge Column -->
                <DataGridTemplateColumn Header="Cue" Width="46">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border CornerRadius="4" Padding="4 1" HorizontalAlignment="Center" MinWidth="30">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type Border}">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding IsStationIdCue}">
                                <Setter Property="Background" Value="#0369A1" />
                              </DataTrigger>
                              <DataTrigger Value="True" Binding="{Binding IsSweeperCue}">
                                <Setter Property="Background" Value="#B45309" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                        <TextBlock FontSize="10" FontWeight="ExtraBold" HorizontalAlignment="Center" Foreground="#FFFFFF" Text="{Binding QueueCueLabel}" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Title" Width="2*" Binding="{Binding Title}" />
                <DataGridTextColumn Header="Category" Width="*" Binding="{Binding Category}" />
                <DataGridTextColumn Header="Duration" Width="68" Binding="{Binding DurationText}" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>