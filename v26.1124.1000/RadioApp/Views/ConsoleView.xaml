<UserControl x:Class="RadioApp.Views.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RadioApp.Controls">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2.15*" />
      <ColumnDefinition Width="14" />
      <ColumnDefinition Width="1*" MinWidth="340" />
    </Grid.ColumnDefinitions>

    <!-- LEFT: ON-AIR PROGRAM DECK + METERING + 8-PAD CARTWALL -->
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="12" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- PRIMARY ON-AIR PROGRAM DECK -->
      <Border Grid.Row="0" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource PrimaryGlowBrush}"
              Background="{StaticResource DeckAGradientBrush}" Padding="18">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="74" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Deck Top Status Row -->
          <DockPanel Grid.Row="0" Margin="0 0 0 12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Background="{StaticResource PrimaryBrush}" CornerRadius="5" Padding="9 3" Margin="0 0 8 0">
                <TextBlock Text="ON AIR PROGRAM DECK" FontSize="11" FontWeight="ExtraBold" Foreground="#FFFFFF" />
              </Border>
              <Border Background="#10253D" BorderBrush="#1F4770" BorderThickness="1" CornerRadius="5" Padding="8 3" Margin="0 0 8 0">
                <TextBlock Text="{Binding ProgramPlayer.TrackCategory}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
              </Border>
              <Border Background="#1D1236" BorderBrush="{StaticResource PurpleCartBrush}" BorderThickness="1" CornerRadius="5" Padding="8 3">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource IconSparkles}" Fill="{StaticResource PurpleCartBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0 0 5 0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ProgramPlayer.NextTransitionSummary}" FontSize="11" FontWeight="SemiBold" Foreground="#E9D5FF" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Visibility="{Binding ProgramPlayer.HasIntroCountdown, Converter={StaticResource BoolToVisibilityConverter}}"
                      Background="#164E63" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="9 3" Margin="0 0 8 0">
                <TextBlock Text="{Binding ProgramPlayer.IntroCountdownText}" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" />
              </Border>
              <Border Background="#0C233C" BorderBrush="{StaticResource PrimaryGlowBrush}" BorderThickness="1" CornerRadius="6" Padding="10 3">
                <TextBlock Text="{Binding ProgramPlayer.PlaybackStateText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryGlowBrush}" />
              </Border>
            </StackPanel>
          </DockPanel>

          <!-- Artwork + Track Metadata + Broadcast Timecode Card -->
          <Grid Grid.Row="1" Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="92" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="230" />
            </Grid.ColumnDefinitions>

            <!-- Album Artwork Box -->
            <Border Grid.Column="0" Width="92" Height="92" CornerRadius="10" Background="#09131F" BorderBrush="#1D3A5F" BorderThickness="1" ClipToBounds="True">
              <Grid>
                <Path Data="{StaticResource IconMusic}" Fill="#1E3A5F" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Source="{Binding ProgramPlayer.AlbumArt}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
              </Grid>
            </Border>

            <!-- Track Info -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding ProgramPlayer.TrackTitle}" FontSize="25" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0 0 0 4" />
              <TextBlock Text="{Binding ProgramPlayer.TrackArtist}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryGlowBrush}" TextTrimming="CharacterEllipsis" Margin="0 0 0 8" />
              <WrapPanel>
                <Border Background="#0F2237" BorderBrush="#1F4770" BorderThickness="1" CornerRadius="5" Padding="8 3" Margin="0 0 6 4">
                  <TextBlock Text="{Binding ProgramPlayer.TrackBpmText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource LiveGreenGlowBrush}" FontFamily="Consolas" />
                </Border>
                <Border Background="#0F2237" BorderBrush="#1F4770" BorderThickness="1" CornerRadius="5" Padding="8 3" Margin="0 0 6 4">
                  <TextBlock Text="{Binding ProgramPlayer.TrackLoudnessText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                </Border>
                <Border Background="#0F2237" BorderBrush="#1F4770" BorderThickness="1" CornerRadius="5" Padding="8 3" Margin="0 0 6 4"
                        Visibility="{Binding ProgramPlayer.TrackAlbum, Converter={StaticResource NullToVisibilityConverter}}">
                  <TextBlock Text="{Binding ProgramPlayer.TrackAlbum}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                </Border>
              </WrapPanel>
            </StackPanel>

            <!-- Broadcast Timecode Display -->
            <Border Grid.Column="4" Background="#08121E" BorderBrush="#1D3A5F" BorderThickness="1" CornerRadius="10" Padding="12 8">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="REMAINING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ProgramPlayer.RemainingFormatted}" FontSize="34" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0 2 0 4">
                  <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                      <Setter Property="Foreground" Value="{StaticResource PrimaryGlowBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ProgramPlayer.IsEndingSoon}" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource WarningAmberBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProgramPlayer.IsCriticalEnding}" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource DangerRedBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <TextBlock Text="{Binding ProgramPlayer.ElapsedFormatted}" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource TextBrush}" />
                  <TextBlock Text=" / " FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                  <TextBlock Text="{Binding ProgramPlayer.TotalDurationFormatted}" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Interactive Waveform & Cue Timeline -->
          <controls:WaveformCueControl Grid.Row="2" Margin="0 0 0 12"
                                       WaveformPeaks="{Binding ProgramPlayer.WaveformPeaks}"
                                       ProgressPercent="{Binding ProgramPlayer.PlaybackProgress}"
                                       DurationSeconds="{Binding ProgramPlayer.DurationSeconds}"
                                       IntroSeconds="{Binding ProgramPlayer.IntroSeconds}"
                                       MixOutSeconds="{Binding ProgramPlayer.MixOutSeconds}"
                                       EndSeconds="{Binding ProgramPlayer.EndSeconds}"
                                       SeekCommand="{Binding ProgramPlayer.SeekPercentCommand}"
                                       ToolTip="Click or drag anywhere on the waveform to scrub. Amber zone = AutoMix segue window." />

          <!-- Transport Bar -->
          <Border Grid.Row="3" Background="#08121E" BorderBrush="#1D3A5F" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0 0 0 12">
            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Button ToolTip="Load Audio File" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 6 0" Command="{Binding ProgramPlayer.LoadFileCommand}">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconFolder}" Fill="{StaticResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0 0 6 0" />
                    <TextBlock Text="Load" />
                  </StackPanel>
                </Button>
                <Button ToolTip="Load Random Track" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 6 0" Command="{Binding RandomizeDeckCommand}">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconShuffle}" Fill="{StaticResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0 0 6 0" />
                    <TextBlock Text="Random" />
                  </StackPanel>
                </Button>
                <Button ToolTip="Return to Cue Start" Style="{StaticResource SecondaryButtonStyle}" Content="CUE" FontWeight="Bold" Command="{Binding ProgramPlayer.CueCommand}" />
              </StackPanel>

              <!-- Tempo Presets Right -->
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ProgramPlayer.Tempo, StringFormat='{}{0:0.00}x'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource PrimaryGlowBrush}" VerticalAlignment="Center" Margin="0 0 8 0" />
                <Button Content="0.95x" Style="{StaticResource SecondaryButtonStyle}" Padding="8 4" Margin="0 0 4 0" Command="{Binding ProgramPlayer.SlowTempoCommand}" />
                <Button Content="1.00x" Style="{StaticResource SecondaryButtonStyle}" Padding="8 4" Margin="0 0 4 0" Command="{Binding ProgramPlayer.NormalTempoCommand}" />
                <Button Content="1.06x" Style="{StaticResource SecondaryButtonStyle}" Padding="8 4" Command="{Binding ProgramPlayer.FastTempoCommand}" />
              </StackPanel>

              <!-- Center Main Transport Buttons -->
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button ToolTip="Play (Space)" Style="{StaticResource LiveActionButtonStyle}" Width="58" Height="42" Margin="0 0 8 0" Command="{Binding ProgramPlayer.PlayCommand}">
                  <Path Data="{StaticResource IconPlay}" Fill="#042F1A" Width="18" Height="18" Stretch="Uniform" />
                </Button>
                <Button ToolTip="Pause (Space)" Style="{StaticResource SecondaryButtonStyle}" Width="48" Height="42" Margin="0 0 8 0" Command="{Binding ProgramPlayer.PauseCommand}">
                  <Path Data="{StaticResource IconPause}" Fill="{StaticResource TextBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <Button ToolTip="Stop" Style="{StaticResource DangerButtonStyle}" Width="48" Height="42" Margin="0 0 8 0" Command="{Binding ProgramPlayer.StopCommand}">
                  <Path Data="{StaticResource IconStop}" Fill="#FECACA" Width="14" Height="14" Stretch="Uniform" />
                </Button>
                <Button ToolTip="Smooth Crossfade to Next Queued Track (Ctrl+Right)" Style="{StaticResource PrimaryActionButtonStyle}" Height="42" Padding="14 0" Command="{Binding PlayNextCommand}">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconNext}" Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" Margin="0 0 6 0" />
                    <TextBlock Text="Mix Next" FontWeight="Bold" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- Broadcast Metering + Decoupled Monitor vs Master Gain + Mic Talk-Over -->
          <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.45*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Live Stereo Peak/RMS/LUFS & Limiter GR Meter -->
            <Border Grid.Column="0" Background="#08121E" BorderBrush="#1D3A5F" BorderThickness="1" CornerRadius="10" Padding="10">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0 0 0 6">
                  <TextBlock Text="MASTER OUTPUT BUS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding MomentaryLufsText}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource LiveGreenGlowBrush}" Margin="0 0 10 0" />
                    <TextBlock Text="{Binding LimiterGrText}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource WarningAmberBrush}" />
                  </StackPanel>
                </DockPanel>
                <controls:StereoVuMeterControl Grid.Row="1" Height="34"
                                               LeftDb="{Binding MeterLeftDb}"
                                               RightDb="{Binding MeterRightDb}"
                                               GainReductionDb="{Binding LimiterGrDb}" />
              </Grid>
            </Border>

            <!-- Decoupled Local Studio Monitor Volume & Mute -->
            <Border Grid.Column="2" Background="#08121E" BorderBrush="#1D3A5F" BorderThickness="1" CornerRadius="10" Padding="10">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0 0 0 6">
                  <TextBlock Text="STUDIO MONITOR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                  <Button DockPanel.Dock="Right" MinHeight="22" Padding="8 2" FontSize="10" Command="{Binding ToggleMonitorMuteCommand}"
                          ToolTip="Mute local studio speakers only (does NOT mute your live stream!)">
                    <Button.Style>
                      <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
                        <Setter Property="Content" Value="MUTE" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding LocalMonitorMuted}" Value="True">
                            <Setter Property="Background" Value="{StaticResource DangerRedSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource DangerRedBrush}" />
                            <Setter Property="Foreground" Value="#FECACA" />
                            <Setter Property="Content" Value="MUTED" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </DockPanel>
                <DockPanel Grid.Row="1">
                  <TextBlock DockPanel.Dock="Right" Width="36" TextAlignment="Right" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource PrimaryGlowBrush}" VerticalAlignment="Center" Text="{Binding LocalMonitorVolume, StringFormat='{}{0:P0}'}" />
                  <Slider Minimum="0" Maximum="1" Value="{Binding LocalMonitorVolume, Mode=TwoWay}" VerticalAlignment="Center" />
                </DockPanel>
              </Grid>
            </Border>

            <!-- Broadcast Master Gain + Live Mic Talk-Over -->
            <Border Grid.Column="4" Background="#08121E" BorderBrush="#1D3A5F" BorderThickness="1" CornerRadius="10" Padding="10">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0 0 0 6">
                  <TextBlock Text="AIR GAIN / MIC" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                  <Button DockPanel.Dock="Right" MinHeight="22" Padding="8 2" FontSize="10" Command="{Binding ToggleMicTalkOverCommand}"
                          ToolTip="Toggle Live Microphone Talk-Over (automatically ducks music)">
                    <Button.Style>
                      <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
                        <Setter Property="Content" Value="MIC OFF" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding MicTalkOverActive}" Value="True">
                            <Setter Property="Background" Value="{StaticResource DangerRedBrush}" />
                            <Setter Property="BorderBrush" Value="#FCA5A5" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                            <Setter Property="Content" Value="MIC LIVE" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </DockPanel>
                <DockPanel Grid.Row="1">
                  <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Text="{Binding BroadcastMasterGainDb, StringFormat='{}{0:+0.0;-0.0;0.0}dB'}" />
                  <Slider Minimum="-18" Maximum="12" Value="{Binding BroadcastMasterGainDb, Mode=TwoWay}" VerticalAlignment="Center" />
                </DockPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <!-- REAL 8-PAD PROGRAMMABLE CARTWALL (F1 - F8) -->
      <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0 0 0 8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="INSTANT CARTWALL &amp; OVERLAY PADS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PurpleCartBrush}" />
              <TextBlock Text="  •  Left-click or F1–F8 to fire on air  •  Right-click any pad to assign audio" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Stop All Carts" Style="{StaticResource SecondaryButtonStyle}" MinHeight="24" Padding="10 2" FontSize="11" Command="{Binding StopAllOverlaysCommand}" />
          </DockPanel>

          <ItemsControl Grid.Row="1" ItemsSource="{Binding CartPads}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="4" Rows="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Margin="3" MinHeight="56" Padding="8 6"
                        Command="{Binding DataContext.TriggerCartPadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        BorderBrush="{Binding ColorHex, Converter={StaticResource HexColorToBrushConverter}}"
                        BorderThickness="1.5"
                        HorizontalContentAlignment="Stretch"
                        MouseRightButtonUp="CartPad_MouseRightButtonUp"
                        ToolTip="Left-click to trigger on air • Right-click to configure">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                      <Border DockPanel.Dock="Right" Background="#0F172A" CornerRadius="4" Padding="5 1">
                        <TextBlock Text="{Binding Hotkey}" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{Binding ColorHex, Converter={StaticResource HexColorToBrushConverter}}" />
                      </Border>
                      <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding FileNameText}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0 3 0 0" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </Grid>

    <!-- RIGHT: SMART QUEUE & PLAYSET DRAWER -->
    <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0 0 0 8">
          <TextBlock Text="PLAYOUT QUEUE" Style="{StaticResource SectionTitleStyle}" />
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding QueueStatus}" Style="{StaticResource TinyStatusStyle}" Margin="0 0 8 0" />
            <Border Background="#162235" CornerRadius="4" Padding="6 2">
              <TextBlock Text="{Binding QueueTotalDurationText}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryGlowBrush}" />
            </Border>
          </StackPanel>
        </DockPanel>

        <!-- Quick Playset Loader Bar -->
        <Grid Grid.Row="1" Margin="0 0 0 10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox ItemsSource="{Binding Library.Playsets}" SelectedItem="{Binding SelectedQuickPlayset, Mode=TwoWay}" DisplayMemberPath="Name" ToolTip="Select a Playset to load into the queue" />
          <Button Grid.Column="1" Content="Load" Style="{StaticResource PrimaryActionButtonStyle}" Padding="10 4" Margin="6 0 0 0" Command="{Binding LoadPlaysetReplaceCommand}" CommandParameter="{Binding SelectedQuickPlayset}" />
          <Button Grid.Column="2" Content="Mix" Style="{StaticResource SecondaryButtonStyle}" Padding="10 4" Margin="4 0 0 0" ToolTip="Load Playset Shuffled" Command="{Binding LoadPlaysetShuffledCommand}" CommandParameter="{Binding SelectedQuickPlayset}" />
        </Grid>

        <!-- Automation Telemetry Mini-Card -->
        <Border Grid.Row="2" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0 0 0 10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="68" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="UP NEXT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryGlowBrush}" Margin="0 0 0 4" VerticalAlignment="Center" />
            <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding NextQueueCue}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0 0 0 4" VerticalAlignment="Center" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="ROTATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource LiveGreenGlowBrush}" Margin="0 0 0 4" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RotationCue}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0 0 6 4" VerticalAlignment="Center" />
            <Button Grid.Row="1" Grid.Column="2" Content="Manage" Style="{StaticResource SecondaryButtonStyle}" MinHeight="20" Padding="7 1" FontSize="10" Margin="0 0 0 4"
                    Command="{Binding OpenRotationManagerCommand}" ToolTip="Open 24-Hour Rotation Manager" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="IMAGING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource WarningAmberBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0 0 6 0" VerticalAlignment="Center">
              <Run Text="{Binding NextRadioIdCue, Mode=OneWay}" />
              <Run Text="  •  " />
              <Run Text="{Binding NextSweeperCue, Mode=OneWay}" />
            </TextBlock>
            <Button Grid.Row="2" Grid.Column="2" Content="Tune" Style="{StaticResource SecondaryButtonStyle}" MinHeight="20" Padding="7 1" FontSize="10"
                    Command="{Binding OpenImagingSettingsCommand}" ToolTip="Open Sweeper &amp; Station ID Threshold Editor" />
          </Grid>
        </Border>

        <!-- Queue Action Toolbar -->
        <WrapPanel Grid.Row="3" Margin="0 0 0 8">
          <Button Content="Auto Pick" Style="{StaticResource SecondaryButtonStyle}" Padding="10 4" Margin="0 0 5 5" Command="{Binding EnqueueRandomCommand}" />
          <Button Content="▲" ToolTip="Move Selected Up" Style="{StaticResource SecondaryButtonStyle}" Padding="9 4" Margin="0 0 4 5" Command="{Binding MoveQueueItemUpCommand}" />
          <Button Content="▼" ToolTip="Move Selected Down" Style="{StaticResource SecondaryButtonStyle}" Padding="9 4" Margin="0 0 5 5" Command="{Binding MoveQueueItemDownCommand}" />
          <Button Content="Remove" Style="{StaticResource SecondaryButtonStyle}" Padding="9 4" Margin="0 0 5 5" Command="{Binding RemoveQueueItemCommand}" />
          <Button Content="Save Set" Style="{StaticResource SecondaryButtonStyle}" Padding="9 4" Margin="0 0 5 5" Command="{Binding SaveQueueAsPlaysetCommand}" />
          <Button Content="Clear" Style="{StaticResource DangerButtonStyle}" Padding="9 4" Margin="0 0 0 5" Command="{Binding ClearQueueCommand}" />
        </WrapPanel>

        <!-- Virtualized Queue DataGrid with Projected Airtimes -->
        <DataGrid Grid.Row="4" IsReadOnly="True" ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedQueueItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Air" Width="62" Binding="{Binding ProjectedStartText}">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="{x:Type TextBlock}">
                  <Setter Property="FontFamily" Value="Consolas" />
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="Foreground" Value="{StaticResource PrimaryGlowBrush}" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTemplateColumn Header="Cue" Width="42">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border CornerRadius="4" Padding="4 1" HorizontalAlignment="Center" MinWidth="28">
                    <Border.Style>
                      <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsStationIdCue}" Value="True">
                            <Setter Property="Background" Value="#0369A1" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsSweeperCue}" Value="True">
                            <Setter Property="Background" Value="#B45309" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsCommercialCue}" Value="True">
                            <Setter Property="Background" Value="#6D28D9" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding QueueCueLabel}" FontSize="10" FontWeight="ExtraBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Title" Width="*" Binding="{Binding Title}" />
            <DataGridTextColumn Header="BPM" Width="46" Binding="{Binding BpmText}" />
            <DataGridTextColumn Header="Len" Width="50" Binding="{Binding DurationText}" />
          </DataGrid.Columns>
        </DataGrid>

        <!-- Activity Footer -->
        <TextBlock Grid.Row="5" Text="{Binding ActivityStatus}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0 8 0 0" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
