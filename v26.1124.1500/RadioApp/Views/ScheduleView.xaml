<UserControl x:Class="RadioApp.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Margin="0 0 0 12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox Content="Top-of-Hour Sync" IsChecked="{Binding TopOfHourSyncEnabled, Mode=TwoWay}" Margin="0 0 16 0" />
          <CheckBox Content="Timed Station IDs" IsChecked="{Binding RadioIdsEnabled, Mode=TwoWay}" Margin="0 0 16 0" />
          <CheckBox Content="Auto Sweepers" IsChecked="{Binding SweepersEnabled, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="BROADCAST SCHEDULE &amp; TIMED PLAYSETS" FontSize="17" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryGlowBrush}" />
          <TextBlock Text="Schedule curated Playsets, Smart Sets, folder blocks, Station IDs, and priority overrides" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0 2 0 0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <WrapPanel Grid.Row="1" Margin="0 0 0 12">
      <Button Content="+ Add Event" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0 0 8 0" Command="{Binding Schedule.AddScheduleCommand}" />
      <Button Content="Edit Event" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 0" Command="{Binding Schedule.EditScheduleCommand}" />
      <Button Content="Toggle Active" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 0" Command="{Binding Schedule.ToggleEnabledCommand}" />
      <Button Content="Delete" Style="{StaticResource DangerButtonStyle}" Margin="0 0 8 0" Command="{Binding Schedule.DeleteScheduleCommand}" />
      <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Schedule.RefreshCommand}" />
    </WrapPanel>

    <DataGrid Grid.Row="2" IsReadOnly="True" ItemsSource="{Binding Schedule.Items}" SelectedItem="{Binding Schedule.SelectedItem, Mode=TwoWay}">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Main" Width="54" Binding="{Binding IsMain}" />
        <DataGridCheckBoxColumn Header="Active" Width="60" Binding="{Binding Enabled}" />
        <DataGridTextColumn Header="Next Run" Width="150" Binding="{Binding ScheduledAt, StringFormat=g}" />
        <DataGridTextColumn Header="Type" Width="105" Binding="{Binding EventType}" />
        <DataGridTextColumn Header="Recurrence" Width="100" Binding="{Binding RepeatMode}" />
        <DataGridTextColumn Header="Tolerance" Width="90" Binding="{Binding ToleranceAfterMinutes, StringFormat='+{0} min'}" />
        <DataGridTextColumn Header="Block" Width="76" Binding="{Binding BlockDurationMinutes, StringFormat='{}{0} min'}" />
        <DataGridTextColumn Header="Title" Width="1.5*" Binding="{Binding Title}" />
        <DataGridTextColumn Header="Source (Playset / Path)" Width="2*" Binding="{Binding SourceSummary}" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
