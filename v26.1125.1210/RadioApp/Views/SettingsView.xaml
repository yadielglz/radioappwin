<UserControl x:Class="RadioApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RadioApp.Models;assembly=RadioApp.Core"
             xmlns:controls="clr-namespace:RadioApp.Controls">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="226" />
      <ColumnDefinition Width="14" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- LEFT RAIL SETTINGS NAVIGATION -->
    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0 0 0 12">
          <TextBlock Text="STUDIO SETTINGS" FontSize="14" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryGlowBrush}" />
          <TextBlock Text="All changes save &amp; apply live" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0 2 0 0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0 10 0 0">
          <Button Content="Refresh Audio Devices" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 0 6" Command="{Binding RefreshAudioDevicesCommand}" />
          <Button Content="Open Diagnostics Logs" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenLogsFolderCommand}" />
        </StackPanel>

        <ListBox x:Name="SectionNavList" SelectedIndex="{Binding SelectedSettingsSectionIndex, Mode=TwoWay}">
          <ListBox.ItemContainerStyle>
            <Style TargetType="{x:Type ListBoxItem}">
              <Setter Property="Padding" Value="12 10" />
              <Setter Property="Margin" Value="0 0 0 4" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelCardBrush}" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#0C3152" />
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryGlowBrush}" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBoxItem Content="General &amp; System" />
          <ListBoxItem Content="Transitions &amp; AutoMix" />
          <ListBoxItem Content="Audio Routing &amp; DSP" />
          <ListBoxItem Content="Rotation Manager" />
          <ListBoxItem Content="Sweepers, IDs &amp; Watchdog" />
          <ListBoxItem Content="Broadcast &amp; Streaming" />
          <ListBoxItem Content="Library &amp; Maintenance" />
          <ListBoxItem Content="Cloud PC &amp; Git Updates" />
        </ListBox>
      </DockPanel>
    </Border>

    <!-- RIGHT CONTENT PANE -->
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <Grid>
        <!-- SECTION 0: GENERAL & SYSTEM -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSectionIndex}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <GroupBox Header="Startup &amp; Session Continuity">
            <StackPanel>
              <CheckBox Content="Connect and publish live broadcast stream automatically on startup" IsChecked="{Binding AutoConnectStreamOnStartup, Mode=TwoWay}" Margin="0 0 0 10" />
              <CheckBox Content="Restore saved playout queue automatically on startup" IsChecked="{Binding RestoreQueueOnStartup, Mode=TwoWay}" Margin="0 0 0 10" />
              <CheckBox Content="Start minimized to Windows system tray" IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}" />
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Windows System Tray">
            <StackPanel>
              <CheckBox Content="Minimize to tray instead of keeping taskbar button" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" Margin="0 0 0 10" />
              <CheckBox Content="Close button (X) keeps RadioApp running in tray until File → Exit" IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Configuration Backup &amp; Diagnostics">
            <WrapPanel>
              <Button Content="Export Settings Backup..." Style="{StaticResource PrimaryActionButtonStyle}" Margin="0 0 8 8" Command="{Binding ExportSettingsCommand}" />
              <Button Content="Import Settings Backup..." Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 8" Command="{Binding ImportSettingsCommand}" />
              <Button Content="Open Rotating Logs Folder" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 8" Command="{Binding OpenLogsFolderCommand}" />
            </WrapPanel>
          </GroupBox>
        </StackPanel>

        <!-- SECTION 1: TRANSITIONS & AUTOMIX (APPLE MUSIC-GRADE ENGINE) -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSectionIndex}" Value="1">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <GroupBox Header="Radio Gapless &amp; Broadcast Transition Engine">
            <StackPanel>
              <CheckBox Content="Enable Gapless &amp; Broadcast Transition Engine" IsChecked="{Binding GaplessPlaybackEnabled, Mode=TwoWay}" Margin="0 0 0 14" />

              <Grid Margin="0 0 0 6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Transition Mode:" Style="{StaticResource LabelStyle}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding TransitionModeOptions}" SelectedItem="{Binding TransitionMode, Mode=TwoWay}" />
              </Grid>
              <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="210 0 0 12"
                         Text="RadioGapless (Recommended): True FM radio feel — trims dead silence and lets cold/rhythmic songs finish completely with a tight gapless handoff; segues cleanly only inside genuine fade-out tails (no unwanted DJ crossfades)." />

              <Grid Margin="0 0 0 12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Crossfade Curve / EQ:" Style="{StaticResource LabelStyle}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding CrossfadeCurveOptions}" SelectedItem="{Binding CrossfadeCurve, Mode=TwoWay}" />
              </Grid>

              <CheckBox Content="Enable 4th-Order Linkwitz-Riley Bass-Swap EQ during transitions (prevents kick/bass mud)" IsChecked="{Binding AutoMixBassSwapEnabled, Mode=TwoWay}" Margin="0 4 0 12" />

              <Grid Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="74" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="AutoMix Beat-Sync Tolerance:" Style="{StaticResource LabelStyle}" />
                <Slider Grid.Column="1" Minimum="0" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding AutoMixMaxTempoStretchPercent, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource PrimaryGlowBrush}" Text="{Binding AutoMixMaxTempoStretchPercent, StringFormat='±{0:0.0}%'}" />
              </Grid>

              <Grid Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="74" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Bass-Swap Crossover Freq:" Style="{StaticResource LabelStyle}" />
                <Slider Grid.Column="1" Minimum="80" Maximum="350" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding AutoMixBassSwapHz, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource PrimaryGlowBrush}" Text="{Binding AutoMixBassSwapHz, StringFormat='{}{0:0} Hz'}" />
              </Grid>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Timing &amp; Category Transition Matrix">
            <StackPanel>
              <Grid Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="74" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Manual 'Mix Next' Crossfade:" Style="{StaticResource LabelStyle}" />
                <Slider Grid.Column="1" Minimum="100" Maximum="3000" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding ManualSkipCrossfadeMs, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource PrimaryGlowBrush}" Text="{Binding ManualSkipCrossfadeMs, StringFormat='{}{0} ms'}" />
              </Grid>

              <Grid Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="74" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Classic Crossfade Duration:" Style="{StaticResource LabelStyle}" />
                <Slider Grid.Column="1" Minimum="500" Maximum="12000" TickFrequency="250" IsSnapToTickEnabled="True" Value="{Binding ClassicCrossfadeMs, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource PrimaryGlowBrush}" Text="{Binding ClassicCrossfadeMs, StringFormat='{}{0} ms'}" />
              </Grid>

              <Grid Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="74" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Commercial Spot Tight Segue:" Style="{StaticResource LabelStyle}" />
                <Slider Grid.Column="1" Minimum="0" Maximum="500" TickFrequency="25" IsSnapToTickEnabled="True" Value="{Binding CommercialGaplessMs, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource PrimaryGlowBrush}" Text="{Binding CommercialGaplessMs, StringFormat='{}{0} ms'}" />
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="74" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Silence Trim Floor:" Style="{StaticResource LabelStyle}" />
                <Slider Grid.Column="1" Minimum="-66" Maximum="-24" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding GaplessSilenceThresholdDb, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource PrimaryGlowBrush}" Text="{Binding GaplessSilenceThresholdDb, StringFormat='{}{0:0} dB'}" />
              </Grid>
            </StackPanel>
          </GroupBox>
        </StackPanel>

        <!-- SECTION 2: AUDIO ROUTING & BROADCAST DSP -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSectionIndex}" Value="2">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <GroupBox Header="Audio Hardware Routing (Live Hot-Swap)">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Master Playout Output:" Style="{StaticResource LabelStyle}" Margin="0 0 10 10" />
              <ComboBox Grid.Row="0" Grid.Column="1" DisplayMemberPath="DisplayName" SelectedValuePath="DeviceNumber" ItemsSource="{Binding OutputAudioDevices}" SelectedValue="{Binding SelectedOutputDeviceNumber, Mode=TwoWay}" Margin="0 0 8 10" />
              <Button Grid.Row="0" Grid.Column="2" Content="Test Tone" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 0 10" Command="{Binding TestAudioOutputCommand}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="PFL / Audition Cue Device:" Style="{StaticResource LabelStyle}" Margin="0 0 10 10" />
              <ComboBox Grid.Row="1" Grid.Column="1" DisplayMemberPath="DisplayName" SelectedValuePath="DeviceNumber" ItemsSource="{Binding OutputAudioDevices}" SelectedValue="{Binding SelectedPflOutputDeviceNumber, Mode=TwoWay}" Margin="0 0 8 10" />
              <Button Grid.Row="1" Grid.Column="2" Content="Test PFL" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 0 10" Command="{Binding TestPflOutputCommand}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Microphone / Talk-Over Input:" Style="{StaticResource LabelStyle}" Margin="0 0 10 10" />
              <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" DisplayMemberPath="DisplayName" SelectedValuePath="DeviceNumber" ItemsSource="{Binding InputAudioDevices}" SelectedValue="{Binding SelectedInputDeviceNumber, Mode=TwoWay}" Margin="0 0 0 10" />

              <TextBlock Grid.Row="3" Grid.Column="0" Text="Mic Talk-Over Music Duck:" Style="{StaticResource LabelStyle}" />
              <Slider Grid.Row="3" Grid.Column="1" Minimum="-24" Maximum="-3" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MicDuckDb, Mode=TwoWay}" Margin="0 0 8 0" />
              <TextBlock Grid.Row="3" Grid.Column="2" FontFamily="Consolas" Foreground="{StaticResource PrimaryGlowBrush}" VerticalAlignment="Center" Text="{Binding MicDuckDb, StringFormat='{}{0:0} dB'}" />
            </Grid>
          </GroupBox>

          <GroupBox Header="EBU R128 Loudness Normalization &amp; Lookahead True-Peak Limiter">
            <StackPanel>
              <CheckBox Content="Enable EBU R128 integrated loudness matching (constant per-track gain, zero AGC pumping)" IsChecked="{Binding AudioNormalizationEnabled, Mode=TwoWay}" Margin="0 0 0 12" />

              <Grid Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="190" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Target Loudness (LUFS):" Style="{StaticResource LabelStyle}" />
                <Slider Grid.Column="1" Minimum="-24" Maximum="-6" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding NormalizationTargetDb, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource LiveGreenGlowBrush}" Text="{Binding NormalizationTargetDb, StringFormat='{}{0:0.0} LUFS'}" />
              </Grid>

              <Grid Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="190" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Max ReplayGain Boost:" Style="{StaticResource LabelStyle}" />
                <Slider Grid.Column="1" Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding NormalizationMaxGainDb, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource PrimaryGlowBrush}" Text="{Binding NormalizationMaxGainDb, StringFormat='+{0:0} dB'}" />
              </Grid>

              <CheckBox Content="Enable 5ms Lookahead True-Peak Brickwall Safety Limiter" IsChecked="{Binding AudioLimiterEnabled, Mode=TwoWay}" Margin="0 6 0 10" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="190" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="True-Peak Ceiling:" Style="{StaticResource LabelStyle}" />
                <Slider Grid.Column="1" Minimum="-6" Maximum="-0.1" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding TruePeakCeilingDb, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource WarningAmberBrush}" Text="{Binding TruePeakCeilingDb, StringFormat='{}{0:0.0} dBTP'}" />
              </Grid>
            </StackPanel>
          </GroupBox>
        </StackPanel>

        <!-- SECTION 3: VISUAL 24-HOUR ROTATION MANAGER -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSectionIndex}" Value="3">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <!-- 24-Hour Daypart Timeline & Quick Templates -->
          <GroupBox Header="24-Hour Broadcast Rotation Clock &amp; Dayparts">
            <StackPanel>
              <DockPanel Margin="0 0 0 8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Preview Day:" Style="{StaticResource LabelStyle}" Margin="0 0 6 0" />
                  <ComboBox Width="118" ItemsSource="{Binding DayOfWeekOptions}" SelectedItem="{Binding RotationPreviewDay, Mode=TwoWay}" Margin="0 0 8 0" />
                  <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Padding="10 4" Command="{Binding RefreshRotationAndImagingCommand}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding RotationCue, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource LiveGreenGlowBrush}" />
                  <TextBlock Text="{Binding RotationCoverageSummary, Mode=OneWay}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0 2 0 0" />
                </StackPanel>
              </DockPanel>

              <controls:RotationTimelineControl
                Blocks="{Binding RotationBlocks}"
                SelectedBlock="{Binding SelectedRotationBlock, Mode=TwoWay}"
                PreviewDay="{Binding RotationPreviewDay, Mode=OneWay}"
                Revision="{Binding RotationTimelineRevision, Mode=OneWay}"
                Margin="0 0 0 10" />

              <WrapPanel>
                <Button Content="+ New Daypart Block" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0 0 8 6" Command="{Binding AddRotationBlockCommand}" />
                <Button Content="Duplicate Selected" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 6" Command="{Binding DuplicateRotationBlockCommand}" />
                <Button Content="Delete Selected" Style="{StaticResource DangerButtonStyle}" Margin="0 0 14 6" Command="{Binding RemoveRotationBlockCommand}" />
                <TextBlock Text="Templates:" Style="{StaticResource LabelStyle}" Margin="0 0 6 6" />
                <Button Content="Broadcast Dayparts" Style="{StaticResource SecondaryButtonStyle}" FontSize="11" MinHeight="28" Padding="9 3" Margin="0 0 6 6"
                        Command="{Binding ApplyRotationPresetCommand}" CommandParameter="broadcast_dayparts" />
                <Button Content="Weekday / Weekend" Style="{StaticResource SecondaryButtonStyle}" FontSize="11" MinHeight="28" Padding="9 3" Margin="0 0 6 6"
                        Command="{Binding ApplyRotationPresetCommand}" CommandParameter="weekday_weekend" />
                <Button Content="24/7 All Music" Style="{StaticResource SecondaryButtonStyle}" FontSize="11" MinHeight="28" Padding="9 3" Margin="0 0 0 6"
                        Command="{Binding ApplyRotationPresetCommand}" CommandParameter="all_music_24h" />
              </WrapPanel>
            </StackPanel>
          </GroupBox>

          <!-- Split Pane: Block List (Left) + Intuitive Daypart Editor (Right) -->
          <Grid Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.05*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>

            <!-- Daypart Block Cards List -->
            <GroupBox Grid.Column="0" Header="Scheduled Rotation Blocks (Click to Edit)" Margin="0">
              <ListBox ItemsSource="{Binding RotationBlocks}" SelectedItem="{Binding SelectedRotationBlock, Mode=TwoWay}" MinHeight="270" MaxHeight="340"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0 0 0 6" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                          <Border x:Name="Card" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="10 8">
                            <ContentPresenter />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Card" Property="Background" Value="{StaticResource PanelCardBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Card" Property="Background" Value="#0C3152" />
                              <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryGlowBrush}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" CornerRadius="3" Background="{Binding ColorHex, Converter={StaticResource HexColorToBrushConverter}}" />
                      <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" />
                          <TextBlock Text=" (Paused)" FontSize="11" Foreground="{StaticResource WarningAmberBrush}"
                                     Visibility="{Binding Enabled, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SourceSummary, Mode=OneWay}" FontSize="11" Foreground="{StaticResource PrimaryGlowBrush}" Margin="0 2 0 0" />
                        <TextBlock FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0 2 0 0">
                          <Run Text="{Binding TimeRangeDisplay, Mode=OneWay}" />
                          <Run Text="  •  " />
                          <Run Text="{Binding DaysSummary, Mode=OneWay}" />
                          <Run Text="  •  P" />
                          <Run Text="{Binding Priority, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                      <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border CornerRadius="4" Padding="6 2" Background="{StaticResource PanelCardBrush}">
                          <TextBlock Text="{Binding MatchCountText, Mode=OneWay}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource LiveGreenGlowBrush}">
                            <TextBlock.Style>
                              <Style TargetType="{x:Type TextBlock}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding HasZeroMatches}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerRedBrush}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Border>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </GroupBox>

            <!-- Interactive Block Editor -->
            <GroupBox Grid.Column="2" Header="Selected Rotation Block Editor" Margin="0">
              <Grid>
                <TextBlock Text="Select a block on the 24-hour clock or list (or click '+ New Daypart Block') to configure it."
                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Visibility="{Binding HasSelectedRotationBlock, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                <StackPanel Visibility="{Binding HasSelectedRotationBlock, Converter={StaticResource BoolToVisibilityConverter}}">
                  <Grid Margin="0 0 0 10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0 0 10 0">
                      <TextBlock Text="Block Name" Style="{StaticResource LabelStyle}" Margin="0 0 0 3" />
                      <TextBox Text="{Binding SelectedRotationBlock.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Content="Enabled" IsChecked="{Binding SelectedRotationBlock.Enabled, Mode=TwoWay}" VerticalAlignment="Bottom" Margin="0 0 0 6" />
                  </Grid>

                  <UniformGrid Columns="3" Margin="0 0 0 10">
                    <StackPanel Margin="0 0 8 0">
                      <TextBlock Text="Start (HH:mm)" Style="{StaticResource LabelStyle}" Margin="0 0 0 3" />
                      <TextBox Text="{Binding SelectedRotationBlock.StartTime, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="24h format e.g. 06:00 or 22:00" />
                    </StackPanel>
                    <StackPanel Margin="0 0 8 0">
                      <TextBlock Text="End (HH:mm)" Style="{StaticResource LabelStyle}" Margin="0 0 0 3" />
                      <TextBox Text="{Binding SelectedRotationBlock.EndTime, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="Supports overnight wrap e.g. 22:00 to 02:00" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="Priority (1–100)" Style="{StaticResource LabelStyle}" Margin="0 0 0 3" />
                      <TextBox Text="{Binding SelectedRotationBlock.Priority, Mode=TwoWay}" ToolTip="Higher priority wins if two blocks overlap" />
                    </StackPanel>
                  </UniformGrid>

                  <!-- Active Days Picker -->
                  <TextBlock Text="Active Days of Week" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <WrapPanel Margin="0 0 0 6">
                    <CheckBox Content="Mon" IsChecked="{Binding SelectedRotationBlock.Mon, Mode=TwoWay}" Margin="0 0 10 4" />
                    <CheckBox Content="Tue" IsChecked="{Binding SelectedRotationBlock.Tue, Mode=TwoWay}" Margin="0 0 10 4" />
                    <CheckBox Content="Wed" IsChecked="{Binding SelectedRotationBlock.Wed, Mode=TwoWay}" Margin="0 0 10 4" />
                    <CheckBox Content="Thu" IsChecked="{Binding SelectedRotationBlock.Thu, Mode=TwoWay}" Margin="0 0 10 4" />
                    <CheckBox Content="Fri" IsChecked="{Binding SelectedRotationBlock.Fri, Mode=TwoWay}" Margin="0 0 10 4" />
                    <CheckBox Content="Sat" IsChecked="{Binding SelectedRotationBlock.Sat, Mode=TwoWay}" Margin="0 0 10 4" />
                    <CheckBox Content="Sun" IsChecked="{Binding SelectedRotationBlock.Sun, Mode=TwoWay}" Margin="0 0 0 4" />
                  </WrapPanel>
                  <WrapPanel Margin="0 0 0 10">
                    <Button Content="Every Day" Style="{StaticResource SecondaryButtonStyle}" FontSize="10.5" MinHeight="24" Padding="8 2" Margin="0 0 6 0" Command="{Binding SetSelectedBlockDaysCommand}" CommandParameter="all" />
                    <Button Content="Weekdays" Style="{StaticResource SecondaryButtonStyle}" FontSize="10.5" MinHeight="24" Padding="8 2" Margin="0 0 6 0" Command="{Binding SetSelectedBlockDaysCommand}" CommandParameter="weekdays" />
                    <Button Content="Weekends" Style="{StaticResource SecondaryButtonStyle}" FontSize="10.5" MinHeight="24" Padding="8 2" Command="{Binding SetSelectedBlockDaysCommand}" CommandParameter="weekends" />
                  </WrapPanel>

                  <!-- Source Type & Live Dropdown Picker -->
                  <UniformGrid Columns="2" Margin="0 0 0 10">
                    <StackPanel Margin="0 0 8 0">
                      <TextBlock Text="Music Source Type" Style="{StaticResource LabelStyle}" Margin="0 0 0 3" />
                      <ComboBox ItemsSource="{Binding RotationSourceKindOptions}" SelectedItem="{Binding SelectedRotationBlock.SourceKind, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="Source Selection" Style="{StaticResource LabelStyle}" Margin="0 0 0 3" />
                      <!-- Tag Editable ComboBox -->
                      <ComboBox IsEditable="True" ItemsSource="{Binding AvailableRotationTags}"
                                Text="{Binding SelectedRotationBlock.SourceValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Visibility="{Binding SelectedRotationBlock.IsTagSource, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="Pick a library tag or enter comma-separated tags (e.g. upbeat, pop)" />
                      <!-- Category Editable ComboBox -->
                      <ComboBox IsEditable="True" ItemsSource="{Binding AvailableRotationCategories}"
                                Text="{Binding SelectedRotationBlock.SourceValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Visibility="{Binding SelectedRotationBlock.IsCategorySource, Converter={StaticResource BoolToVisibilityConverter}}" />
                      <!-- Playset ComboBox -->
                      <ComboBox ItemsSource="{Binding Library.Playsets}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                SelectedValue="{Binding SelectedRotationBlock.PlaysetId, Mode=TwoWay}"
                                Visibility="{Binding SelectedRotationBlock.IsPlaysetSource, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                  </UniformGrid>

                  <!-- Color Swatches + Optional Per-Block Overrides -->
                  <WrapPanel Margin="0 0 0 10" VerticalAlignment="Center">
                    <TextBlock Text="Color:" Style="{StaticResource LabelStyle}" Margin="0 0 8 0" />
                    <Button Width="22" Height="22" MinHeight="22" Padding="0" Background="#0284C7" Margin="0 0 5 0" Command="{Binding SetSelectedBlockColorCommand}" CommandParameter="#0284C7" />
                    <Button Width="22" Height="22" MinHeight="22" Padding="0" Background="#10B981" Margin="0 0 5 0" Command="{Binding SetSelectedBlockColorCommand}" CommandParameter="#10B981" />
                    <Button Width="22" Height="22" MinHeight="22" Padding="0" Background="#F59E0B" Margin="0 0 5 0" Command="{Binding SetSelectedBlockColorCommand}" CommandParameter="#F59E0B" />
                    <Button Width="22" Height="22" MinHeight="22" Padding="0" Background="#8B5CF6" Margin="0 0 5 0" Command="{Binding SetSelectedBlockColorCommand}" CommandParameter="#8B5CF6" />
                    <Button Width="22" Height="22" MinHeight="22" Padding="0" Background="#EC4899" Margin="0 0 5 0" Command="{Binding SetSelectedBlockColorCommand}" CommandParameter="#EC4899" />
                    <Button Width="22" Height="22" MinHeight="22" Padding="0" Background="#06B6D4" Margin="0 0 5 0" Command="{Binding SetSelectedBlockColorCommand}" CommandParameter="#06B6D4" />
                    <Button Width="22" Height="22" MinHeight="22" Padding="0" Background="#EF4444" Command="{Binding SetSelectedBlockColorCommand}" CommandParameter="#EF4444" />
                  </WrapPanel>

                  <UniformGrid Columns="3">
                    <StackPanel Margin="0 0 8 0">
                      <TextBlock Text="Artist Sep Override (min)" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0 0 0 3" />
                      <TextBox Text="{Binding SelectedRotationBlock.ArtistSeparationOverrideMinutes, Mode=TwoWay, TargetNullValue=''}" ToolTip="Blank = use global separation" />
                    </StackPanel>
                    <StackPanel Margin="0 0 8 0">
                      <TextBlock Text="Sweeper Min Override" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0 0 0 3" />
                      <TextBox Text="{Binding SelectedRotationBlock.SweeperMinSongsOverride, Mode=TwoWay, TargetNullValue=''}" ToolTip="Blank = use global sweeper min songs" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="Sweeper Max Override" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0 0 0 3" />
                      <TextBox Text="{Binding SelectedRotationBlock.SweeperMaxSongsOverride, Mode=TwoWay, TargetNullValue=''}" ToolTip="Blank = use global sweeper max songs" />
                    </StackPanel>
                  </UniformGrid>
                </StackPanel>
              </Grid>
            </GroupBox>
          </Grid>

          <!-- Global Auto-DJ, Default Fallback & Live Rotation Simulator -->
          <GroupBox Header="Global Auto-DJ, Anti-Repeat Rules &amp; Live Rotation Simulator">
            <StackPanel>
              <WrapPanel Margin="0 0 0 10">
                <CheckBox Content="Enable continuous Auto-DJ automation" IsChecked="{Binding AutoScheduleEnabled, Mode=TwoWay}" Margin="0 0 18 4" />
                <CheckBox Content="Auto-fill remaining broadcast hour" IsChecked="{Binding AutoDjFillCurrentHour, Mode=TwoWay}" Margin="0 0 0 4" />
              </WrapPanel>

              <WrapPanel Margin="0 0 0 12">
                <TextBlock Text="Queue Depth:" Style="{StaticResource LabelStyle}" />
                <TextBox Width="52" Text="{Binding AutoDjQueueDepth, Mode=TwoWay}" Margin="0 0 14 4" />
                <TextBlock Text="Artist Sep (min):" Style="{StaticResource LabelStyle}" />
                <TextBox Width="52" Text="{Binding AutoDjArtistSeparationMinutes, Mode=TwoWay}" Margin="0 0 14 4" />
                <TextBlock Text="Track Sep (hrs):" Style="{StaticResource LabelStyle}" />
                <TextBox Width="52" Text="{Binding AutoDjTrackSeparationHours, Mode=TwoWay}" Margin="0 0 14 4" />
                <TextBlock Text="Ad Every N Songs:" Style="{StaticResource LabelStyle}" />
                <TextBox Width="52" Text="{Binding AutoDjCommercialIntervalSongs, Mode=TwoWay}" Margin="0 0 0 4" />
              </WrapPanel>

              <UniformGrid Columns="2" Margin="0 0 0 12">
                <StackPanel Margin="0 0 10 0">
                  <TextBlock Text="Default Fallback Source (fills uncovered hours)" Style="{StaticResource LabelStyle}" Margin="0 0 0 3" />
                  <ComboBox ItemsSource="{Binding RotationSourceKindOptions}" SelectedItem="{Binding RotationDefaultSourceKind, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Default Fallback Tag / Category / Playset" Style="{StaticResource LabelStyle}" Margin="0 0 0 3" />
                  <TextBox Text="{Binding AutoDjDefaultTag, Mode=TwoWay}"
                           Visibility="{Binding IsDefaultRotationText, Converter={StaticResource BoolToVisibilityConverter}}"
                           ToolTip="Tag or Category name when no daypart block covers the current hour" />
                  <ComboBox ItemsSource="{Binding Library.Playsets}" DisplayMemberPath="Name" SelectedValuePath="Id"
                            SelectedValue="{Binding RotationDefaultPlaysetId, Mode=TwoWay}"
                            Visibility="{Binding IsDefaultRotationPlayset, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
              </UniformGrid>

              <DockPanel Margin="0 0 0 6">
                <Button DockPanel.Dock="Left" Content="Simulate Next 6 Picks" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0 0 10 0" Command="{Binding SimulateRotationCommand}" />
                <TextBlock Text="Preview exactly what your active rotation &amp; sweeper cadence will select right now without modifying the live queue."
                           FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
              </DockPanel>

              <ListBox ItemsSource="{Binding RotationSimulationResults}" MaxHeight="130" Background="{StaticResource PanelAltBrush}"
                       BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Padding="6"
                       FontFamily="Consolas" FontSize="11.5" />
            </StackPanel>
          </GroupBox>
        </StackPanel>

        <!-- SECTION 4: SWEEPER & STATION ID THRESHOLD EDITOR, ENFORCEMENT & WATCHDOG -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSectionIndex}" Value="4">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <!-- SWEEPER THRESHOLD & ENFORCEMENT EDITOR -->
          <GroupBox Header="Sweeper Threshold Editor &amp; Enforcement">
            <StackPanel>
              <DockPanel Margin="0 0 0 10">
                <Button DockPanel.Dock="Right" Content="Test Sweeper Now" Style="{StaticResource PrimaryActionButtonStyle}" Command="{Binding TestSweeperNowCommand}" Margin="8 0 0 0" />
                <Button DockPanel.Dock="Right" Content="Sweeper Folder..." Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectSweeperFolderCommand}" Margin="8 0 0 0" />
                <CheckBox Content="Enable Auto Sweepers (single-pass accurate counter)" IsChecked="{Binding SweepersEnabled, Mode=TwoWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>

              <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="7" Padding="10 8" Margin="0 0 0 12">
                <StackPanel>
                  <TextBlock Text="{Binding SweeperPoolStatusText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource LiveGreenGlowBrush}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SweeperFolder, Mode=OneWay}" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0 2 0 0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>

              <!-- Duration Threshold Sliders -->
              <UniformGrid Columns="2" Margin="0 0 0 10">
                <StackPanel Margin="0 0 12 0">
                  <DockPanel Margin="0 0 0 3">
                    <TextBlock Text="Min Duration Threshold (sec)" Style="{StaticResource LabelStyle}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SweeperMinDurationSeconds, StringFormat='{}{0:0.0} s'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource PrimaryGlowBrush}" />
                  </DockPanel>
                  <Slider Minimum="0.5" Maximum="30" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding SweeperMinDurationSeconds, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel>
                  <DockPanel Margin="0 0 0 3">
                    <TextBlock Text="Max Duration Threshold (sec)" Style="{StaticResource LabelStyle}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SweeperMaxDurationSeconds, StringFormat='{}{0:0.0} s'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource PrimaryGlowBrush}" />
                  </DockPanel>
                  <Slider Minimum="1" Maximum="60" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding SweeperMaxDurationSeconds, Mode=TwoWay}" />
                </StackPanel>
              </UniformGrid>

              <!-- Cadence & Cooldown Thresholds -->
              <UniformGrid Columns="3" Margin="0 0 0 10">
                <StackPanel Margin="0 0 10 0">
                  <TextBlock Text="Min Songs Between Sweepers" Style="{StaticResource LabelStyle}" Margin="0 0 0 3" />
                  <TextBox Text="{Binding SweeperMinSongs, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Margin="0 0 10 0">
                  <TextBlock Text="Max Songs Between Sweepers" Style="{StaticResource LabelStyle}" Margin="0 0 0 3" />
                  <TextBox Text="{Binding SweeperMaxSongs, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Min Time Cooldown (minutes)" Style="{StaticResource LabelStyle}" Margin="0 0 0 3" />
                  <TextBox Text="{Binding SweeperMinCooldownMinutes, Mode=TwoWay}" ToolTip="Prevents firing sweepers too rapidly during short tracks" />
                </StackPanel>
              </UniformGrid>

              <!-- Playback Mode, Overlay Ducking & Categories -->
              <UniformGrid Columns="2" Margin="0 0 0 10">
                <StackPanel Margin="0 0 12 0">
                  <TextBlock Text="Sweeper Playback Mode" Style="{StaticResource LabelStyle}" Margin="0 0 0 3" />
                  <ComboBox ItemsSource="{Binding SweeperPlaybackModeOptions}" SelectedItem="{Binding SweeperPlaybackMode, Mode=TwoWay}"
                            ToolTip="QueueBetweenTracks = standalone; OverlayOverIntro = duck &amp; fire over incoming song intro; SmartAuto = overlay only when track intro cue fits sweeper length" />
                </StackPanel>
                <StackPanel>
                  <DockPanel Margin="0 0 0 3">
                    <TextBlock Text="Intro Overlay Music Ducking (dB)" Style="{StaticResource LabelStyle}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SweeperOverlayDuckDb, StringFormat='{}{0:0.0} dB'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource WarningAmberBrush}" />
                  </DockPanel>
                  <Slider Minimum="-24" Maximum="-2" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding SweeperOverlayDuckDb, Mode=TwoWay}" />
                </StackPanel>
              </UniformGrid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" Content="Enforce adjacent-imaging spacing (never stack back-to-back with IDs or commercials)"
                          IsChecked="{Binding SweeperAvoidAdjacentImaging, Mode=TwoWay}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Matched Categories (CSV)" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0 0 0 2" />
                  <TextBox Text="{Binding SweeperCategoryNames, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </GroupBox>

          <!-- STATION ID THRESHOLD & ENFORCEMENT EDITOR -->
          <GroupBox Header="Station ID (Legal / Top-of-Hour) Threshold Editor &amp; Enforcement">
            <StackPanel>
              <DockPanel Margin="0 0 0 10">
                <Button DockPanel.Dock="Right" Content="Test Station ID Now" Style="{StaticResource PrimaryActionButtonStyle}" Command="{Binding TestStationIdNowCommand}" Margin="8 0 0 0" />
                <Button DockPanel.Dock="Right" Content="ID Folder..." Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectRadioIdFolderCommand}" Margin="8 0 0 0" />
                <CheckBox Content="Enable Timed Hourly Station IDs" IsChecked="{Binding RadioIdsEnabled, Mode=TwoWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>

              <!-- Live 60-Minute Tolerance Window Strip -->
              <controls:StationIdWindowBarControl
                TargetMinute="{Binding RadioIdMinute, Mode=OneWay}"
                ToleranceBefore="{Binding RadioIdToleranceBeforeMinutes, Mode=OneWay}"
                ToleranceAfter="{Binding RadioIdToleranceAfterMinutes, Mode=OneWay}"
                Margin="0 0 0 8" />

              <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="7" Padding="10 8" Margin="0 0 0 12">
                <StackPanel>
                  <TextBlock Text="{Binding RadioIdWindowStatusText, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource WarningAmberBrush}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding RadioIdPoolStatusText, Mode=OneWay}" FontSize="11.5" Foreground="{StaticResource LiveGreenGlowBrush}" Margin="0 2 0 0" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding RadioIdFolder, Mode=OneWay}" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0 2 0 0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>

              <!-- Target Minute + Before/After Tolerance Window Sliders -->
              <UniformGrid Columns="3" Margin="0 0 0 10">
                <StackPanel Margin="0 0 10 0">
                  <DockPanel Margin="0 0 0 3">
                    <TextBlock Text="Target Minute" Style="{StaticResource LabelStyle}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding RadioIdMinute, StringFormat=':{0:00}'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource PrimaryGlowBrush}" />
                  </DockPanel>
                  <Slider Minimum="0" Maximum="59" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding RadioIdMinute, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Margin="0 0 10 0">
                  <DockPanel Margin="0 0 0 3">
                    <TextBlock Text="Early Window (-min)" Style="{StaticResource LabelStyle}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding RadioIdToleranceBeforeMinutes, StringFormat='-{0} min'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource WarningAmberBrush}" />
                  </DockPanel>
                  <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding RadioIdToleranceBeforeMinutes, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel>
                  <DockPanel Margin="0 0 0 3">
                    <TextBlock Text="Late Deadline (+min)" Style="{StaticResource LabelStyle}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding RadioIdToleranceAfterMinutes, StringFormat='+{0} min'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource WarningAmberBrush}" />
                  </DockPanel>
                  <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding RadioIdToleranceAfterMinutes, Mode=TwoWay}" />
                </StackPanel>
              </UniformGrid>

              <!-- Enforcement Mode + Overlay Ducking -->
              <UniformGrid Columns="2" Margin="0 0 0 10">
                <StackPanel Margin="0 0 12 0">
                  <TextBlock Text="Compliance Enforcement Mode" Style="{StaticResource LabelStyle}" Margin="0 0 0 3" />
                  <ComboBox ItemsSource="{Binding StationIdEnforcementModeOptions}" SelectedItem="{Binding RadioIdEnforcementMode, Mode=TwoWay}"
                            ToolTip="QueueInWindow = play at nearest track break in window; HardInterruptAtDeadline = queue in window AND force crossfade if deadline reached; OverlayAtTarget = duck &amp; air right at target minute without cutting song" />
                </StackPanel>
                <StackPanel>
                  <DockPanel Margin="0 0 0 3">
                    <TextBlock Text="Overlay Station ID Ducking (dB)" Style="{StaticResource LabelStyle}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding RadioIdOverlayDuckDb, StringFormat='{}{0:0.0} dB'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource WarningAmberBrush}" />
                  </DockPanel>
                  <Slider Minimum="-24" Maximum="-2" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding RadioIdOverlayDuckDb, Mode=TwoWay}" />
                </StackPanel>
              </UniformGrid>

              <!-- Station ID Duration Threshold Sliders -->
              <UniformGrid Columns="2" Margin="0 0 0 10">
                <StackPanel Margin="0 0 12 0">
                  <DockPanel Margin="0 0 0 3">
                    <TextBlock Text="Min ID Duration Threshold (sec)" Style="{StaticResource LabelStyle}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding RadioIdMinDurationSeconds, StringFormat='{}{0:0.0} s'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource PrimaryGlowBrush}" />
                  </DockPanel>
                  <Slider Minimum="0.5" Maximum="30" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding RadioIdMinDurationSeconds, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel>
                  <DockPanel Margin="0 0 0 3">
                    <TextBlock Text="Max ID Duration Threshold (sec)" Style="{StaticResource LabelStyle}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding RadioIdMaxDurationSeconds, StringFormat='{}{0:0.0} s'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource PrimaryGlowBrush}" />
                  </DockPanel>
                  <Slider Minimum="1" Maximum="60" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding RadioIdMaxDurationSeconds, Mode=TwoWay}" />
                </StackPanel>
              </UniformGrid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                  <CheckBox Content="Top-of-Hour Hard Sync at min :" IsChecked="{Binding TopOfHourSyncEnabled, Mode=TwoWay}" Margin="0 0 8 0" />
                  <TextBox Width="48" Text="{Binding TopOfHourTargetMinute, Mode=TwoWay}" />
                </WrapPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Matched Categories (CSV)" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0 0 0 2" />
                  <TextBox Text="{Binding RadioIdCategoryNames, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </GroupBox>

          <!-- DEAD-AIR WATCHDOG & NOW PLAYING -->
          <GroupBox Header="Audio-Level Dead-Air Watchdog &amp; Local Now Playing Export">
            <StackPanel>
              <CheckBox Content="Enable Dead-Air Watchdog (monitors true RMS audio silence + transport stalls)" IsChecked="{Binding SilenceWatchdogEnabled, Mode=TwoWay}" Margin="0 0 0 8" />
              <WrapPanel Margin="0 0 0 12">
                <TextBlock Text="Timeout (sec):" Style="{StaticResource LabelStyle}" />
                <TextBox Width="52" Text="{Binding SilenceWatchdogTimeoutSeconds, Mode=TwoWay}" Margin="0 0 14 0" />
                <TextBlock Text="Silence Floor (dBFS):" Style="{StaticResource LabelStyle}" />
                <TextBox Width="58" Text="{Binding SilenceWatchdogThresholdDb, Mode=TwoWay}" Margin="0 0 14 0" />
              </WrapPanel>

              <CheckBox Content="Write current track to local text file (OBS, RDS, stream overlays)" IsChecked="{Binding NowPlayingFileExportEnabled, Mode=TwoWay}" Margin="0 0 0 8" />
              <Grid Margin="0 0 0 8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="File Path:" Style="{StaticResource LabelStyle}" />
                <TextBox Grid.Column="1" Text="{Binding NowPlayingFilePath, Mode=TwoWay}" ToolTip="Blank = %APPDATA%\RadioApp\nowplaying.txt" />
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Format:" Style="{StaticResource LabelStyle}" />
                <TextBox Grid.Column="1" Text="{Binding NowPlayingFormat, Mode=TwoWay}" ToolTip="Tokens: {artist}, {title}, {album}, {category}, {duration}" />
              </Grid>
            </StackPanel>
          </GroupBox>
        </StackPanel>

        <!-- SECTION 5: BROADCAST & STREAMING -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSectionIndex}" Value="5">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <GroupBox Header="Icecast / SHOUTcast Source Encoder">
            <StackPanel>
              <UniformGrid Columns="3" Margin="0 0 0 12">
                <StackPanel Margin="0 0 8 0">
                  <TextBlock Text="Protocol" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding StreamConfig.ServerType, Mode=TwoWay}">
                    <ComboBoxItem Content="Icecast 2" Tag="{x:Static models:StreamServerType.Icecast}" />
                    <ComboBoxItem Content="SHOUTcast v1 / v2" Tag="{x:Static models:StreamServerType.Shoutcast}" />
                  </ComboBox>
                </StackPanel>
                <StackPanel Margin="0 0 8 0">
                  <TextBlock Text="Server Host" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding StreamConfig.Host, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Port" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding StreamConfig.Port, Mode=TwoWay}" />
                </StackPanel>
              </UniformGrid>

              <UniformGrid Columns="3" Margin="0 0 0 12">
                <StackPanel Margin="0 0 8 0">
                  <TextBlock Text="Mount Point (Icecast)" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding StreamConfig.Mount, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Margin="0 0 8 0">
                  <TextBlock Text="Username" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding StreamConfig.Username, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel>
                  <DockPanel Margin="0 0 0 4">
                    <TextBlock Text="Source Password (DPAPI)" Style="{StaticResource LabelStyle}" />
                    <CheckBox x:Name="ShowPasswordToggle" DockPanel.Dock="Right" Content="Show" FontSize="11" Checked="ShowPassword_Changed" Unchecked="ShowPassword_Changed" />
                  </DockPanel>
                  <PasswordBox x:Name="StreamPasswordBox" PasswordChanged="StreamPasswordBox_PasswordChanged" />
                  <TextBox x:Name="StreamPasswordPlainBox" Visibility="Collapsed" Text="{Binding StreamConfig.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </UniformGrid>

              <UniformGrid Columns="3" Margin="0 0 0 12">
                <StackPanel Margin="0 0 8 0">
                  <TextBlock Text="MP3 Bitrate (kbps)" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding StreamConfig.Bitrate, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Margin="0 0 8 0">
                  <TextBlock Text="SHOUTcast Stream ID" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding StreamConfig.ShoutcastStreamId, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom">
                  <CheckBox Content="Auto-reconnect on drop" IsChecked="{Binding StreamConfig.AutoReconnectEnabled, Mode=TwoWay}" Margin="0 0 0 6" />
                </StackPanel>
              </UniformGrid>

              <WrapPanel Margin="0 4 0 10">
                <Button Content="Connect &amp; Go Live" Style="{StaticResource LiveActionButtonStyle}" Margin="0 0 8 0" Command="{Binding ConnectStreamCommand}" />
                <Button Content="Disconnect" Style="{StaticResource DangerButtonStyle}" Margin="0 0 8 0" Command="{Binding DisconnectStreamCommand}" />
                <Button Content="Test TCP Connection" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding TestStreamConnectionCommand}" />
              </WrapPanel>

              <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="7" Padding="10">
                <StackPanel>
                  <TextBlock Text="{Binding StreamStatus}" FontWeight="Bold" Foreground="{StaticResource PrimaryGlowBrush}" />
                  <TextBlock Text="{Binding StreamEndpointText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0 2 0 0" />
                  <TextBlock Text="{Binding StreamTestStatus}" FontSize="11" Foreground="{StaticResource LiveGreenGlowBrush}" Margin="0 4 0 0"
                             Visibility="{Binding StreamTestStatus, Converter={StaticResource NullToVisibilityConverter}}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Station Directory Headers &amp; Live ICY Song Metadata">
            <StackPanel>
              <UniformGrid Columns="2" Margin="0 0 0 10">
                <StackPanel Margin="0 0 8 0">
                  <TextBlock Text="Station Name" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding StreamConfig.StationName, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Genre" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding StreamConfig.StationGenre, Mode=TwoWay}" />
                </StackPanel>
              </UniformGrid>
              <UniformGrid Columns="2" Margin="0 0 0 10">
                <StackPanel Margin="0 0 8 0">
                  <TextBlock Text="Station Website URL" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding StreamConfig.StationUrl, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Live Metadata Template" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding StreamConfig.MetadataFormat, Mode=TwoWay}" />
                </StackPanel>
              </UniformGrid>
              <CheckBox Content="Automatically push Artist - Title metadata updates to Icecast / SHOUTcast on every track change"
                        IsChecked="{Binding StreamConfig.PushTrackMetadata, Mode=TwoWay}" />
            </StackPanel>
          </GroupBox>
        </StackPanel>

        <!-- SECTION 6: LIBRARY, ANALYZER & MAINTENANCE -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSectionIndex}" Value="6">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <GroupBox Header="Watched Library Folders &amp; Background AutoMix Analyzer">
            <StackPanel>
              <CheckBox Content="Watch library folders automatically for new, modified, or removed audio files" IsChecked="{Binding Library.BackgroundRefreshEnabled, Mode=TwoWay}" Margin="0 0 0 8" />
              <CheckBox Content="Automatically analyze new tracks in background (EBU R128 LUFS, BPM, Beat Grid, Cues, Waveform)" IsChecked="{Binding AutoAnalyzeLibraryInBackground, Mode=TwoWay}" Margin="0 0 0 10" />
              <WrapPanel Margin="0 0 0 8">
                <Button Content="+ Add Folder" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0 0 6 0" Command="{Binding Library.AddWatchedFolderCommand}" />
                <Button Content="Remove Folder" Style="{StaticResource DangerButtonStyle}" Margin="0 0 6 0" Command="{Binding Library.RemoveWatchedFolderCommand}" />
                <Button Content="Rescan Now" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 6 0" Command="{Binding Library.RescanWatchedFoldersCommand}" />
                <Button Content="Analyze Unanalyzed Tracks" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Library.AnalyzeAllUnanalyzedCommand}" />
              </WrapPanel>
              <ListBox Height="120" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                       ItemsSource="{Binding Library.WatchedFolders}" SelectedItem="{Binding Library.SelectedWatchedFolder, Mode=TwoWay}" />
              <TextBlock Text="{Binding Library.AnalysisStatus}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0 6 0 0" />
            </StackPanel>
          </GroupBox>

          <GroupBox Header="SQLite Database Health &amp; Factory Reset">
            <WrapPanel>
              <Button Content="Backup Database..." Style="{StaticResource PrimaryActionButtonStyle}" Margin="0 0 8 8" Command="{Binding BackupDatabaseCommand}" />
              <Button Content="Verify DB Integrity" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 8" Command="{Binding VerifyDatabaseCommand}" />
              <Button Content="Remove Missing Tracks" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 8" Command="{Binding Library.RemoveMissingFilesCommand}" />
              <Button Content="Clear Library DB" Style="{StaticResource DangerButtonStyle}" Margin="0 0 8 8" Command="{Binding ClearLibraryCommand}" />
              <Button Content="Factory Reset All Settings" Style="{StaticResource DangerButtonStyle}" Margin="0 0 8 8" Command="{Binding ResetAppCommand}" />
            </WrapPanel>
          </GroupBox>
        </StackPanel>

        <!-- SECTION 7: CLOUD PC & GIT UPDATES -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSectionIndex}" Value="7">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <GroupBox Header="Cloud PC &amp; Unattended RDP Broadcast Continuity">
            <StackPanel>
              <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushMedium}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0 0 0 12">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Switch to Headless Clock Now" Style="{StaticResource SecondaryButtonStyle}"
                          Command="{Binding SwitchToHeadlessClockNowCommand}" VerticalAlignment="Center" Margin="12 0 0 0" />
                  <StackPanel>
                    <TextBlock Text="ACTIVE AUDIO CLOCK ENGINE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding ActiveAudioClockText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryGlowBrush}" Margin="0 3 0 0" TextWrapping="Wrap" />
                    <TextBlock Text="When an RDP session disconnects and Windows removes Remote Audio, RadioApp seamlessly hot-swaps to its internal 44.1 kHz Headless Broadcast Clock so AutoMix, DSP, Scheduler, and Icecast/SHOUTcast streaming never drop a beat."
                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0 4 0 0" />
                  </StackPanel>
                </DockPanel>
              </Border>

              <CheckBox Content="Enable Cloud PC Unattended Mode (master switch for RDP-safe failover &amp; keep-awake)"
                        IsChecked="{Binding CloudUnattendedModeEnabled, Mode=TwoWay}" Margin="0 0 0 10" />
              <CheckBox Content="Automatically hot-swap to Headless Broadcast Clock on RDP disconnect or soundcard loss"
                        IsChecked="{Binding AutoFallbackToHeadlessClock, Mode=TwoWay}" Margin="0 0 0 10" />
              <CheckBox Content="Prevent Windows Cloud PC from sleeping or suspending broadcast threads (SetThreadExecutionState)"
                        IsChecked="{Binding KeepSystemAwakeWhileRunning, Mode=TwoWay}" Margin="0 0 0 10" />
              <CheckBox Content="Elevate process priority to Above Normal to prevent background CPU throttling"
                        IsChecked="{Binding ElevateProcessPriority, Mode=TwoWay}" Margin="0 0 0 10" />
              <CheckBox Content="Automatically start playout on startup (for unattended Cloud PC reboots)"
                        IsChecked="{Binding AutoStartPlaybackOnStartup, Mode=TwoWay}" Margin="0 0 0 10" />
              <CheckBox Content="Launch RadioApp Studio automatically when Windows signs in (HKCU Run)"
                        IsChecked="{Binding LaunchOnWindowsLogin, Mode=TwoWay}" />
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Fetch &amp; Install Updates from GitHub Releases">
            <StackPanel>
              <UniformGrid Columns="2" Margin="0 0 0 10">
                <StackPanel Margin="0 0 10 0">
                  <TextBlock Text="GitHub Repository (owner/repo)" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding GitUpdateRepository, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
                <StackPanel>
                  <DockPanel Margin="0 0 0 4">
                    <TextBlock Text="GitHub Token (Private Repo — DPAPI)" Style="{StaticResource LabelStyle}" />
                    <CheckBox x:Name="ShowGitTokenToggle" DockPanel.Dock="Right" Content="Show" FontSize="11" Checked="ShowGitToken_Changed" Unchecked="ShowGitToken_Changed" />
                  </DockPanel>
                  <PasswordBox x:Name="GitTokenBox" PasswordChanged="GitTokenBox_PasswordChanged"
                               ToolTip="Required for private repos (fine-grained PAT with Contents: Read-only). Auto-detects GITHUB_TOKEN or 'gh auth login' if left blank." />
                  <TextBox x:Name="GitTokenPlainBox" Visibility="Collapsed" Text="{Binding GitUpdateToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="Fine-grained PAT with Contents: Read-only" />
                </StackPanel>
              </UniformGrid>

              <CheckBox Content="Check for GitHub updates automatically on startup (auto-uses saved token, GITHUB_TOKEN env var, or 'gh' CLI login)"
                        IsChecked="{Binding AutoCheckForUpdatesOnStartup, Mode=TwoWay}" Margin="0 0 0 10" />

              <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0 0 0 10">
                <StackPanel>
                  <UniformGrid Columns="2" Margin="0 0 0 6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Installed: " Style="{StaticResource LabelStyle}" />
                      <TextBlock Text="{Binding AppVersionText}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Latest on GitHub: " Style="{StaticResource LabelStyle}" />
                      <TextBlock Text="{Binding LatestRemoteVersionText}" FontWeight="Bold" Foreground="{StaticResource LiveGreenGlowBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                  </UniformGrid>

                  <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" Foreground="{StaticResource PrimaryGlowBrush}" TextWrapping="Wrap" Margin="0 2 0 0" />

                  <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding UpdateDownloadPercent, Mode=OneWay}"
                               Foreground="{StaticResource LiveGreenBrush}" Background="{StaticResource PanelCardBrush}" BorderThickness="0"
                               Margin="0 8 0 0"
                               Visibility="{Binding IsCheckingOrDownloadingUpdate, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
              </Border>

              <WrapPanel Margin="0 0 0 10">
                <Button Content="Check GitHub for Updates" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0 0 8 8" Command="{Binding CheckForUpdatesCommand}" />
                <Button Content="Download &amp; Install MSI Update" Style="{StaticResource LiveActionButtonStyle}" Margin="0 0 8 8" Command="{Binding DownloadAndInstallMsiUpdateCommand}" />
                <Button Content="Download &amp; Apply Portable ZIP" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 8" Command="{Binding DownloadAndInstallZipUpdateCommand}" />
                <Button Content="Open Release Page" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 8" Command="{Binding OpenReleasePageCommand}" />
              </WrapPanel>

              <TextBlock Text="Release Notes" Style="{StaticResource LabelStyle}" Margin="0 0 0 4"
                         Visibility="{Binding UpdateReleaseNotes, Converter={StaticResource NullToVisibilityConverter}}" />
              <TextBox Text="{Binding UpdateReleaseNotes, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Height="110" Padding="10 8"
                       Visibility="{Binding UpdateReleaseNotes, Converter={StaticResource NullToVisibilityConverter}}" />
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Direct Local Git Repository Sync (git fetch / git pull)">
            <StackPanel>
              <TextBlock Text="Optional: point to a local git clone of this repository to fetch or fast-forward pull commits directly from the Cloud PC."
                         FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0 0 0 10" />
              <DockPanel Margin="0 0 0 10">
                <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource SecondaryButtonStyle}" Margin="8 0 0 0" Command="{Binding BrowseLocalGitRepoCommand}" />
                <TextBox Text="{Binding LocalGitRepoPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Leave empty to auto-detect from application folder" />
              </DockPanel>
              <WrapPanel Margin="0 0 0 8">
                <Button Content="Git Fetch &amp; Check Status" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0 0 8 6" Command="{Binding GitFetchLocalRepoCommand}" />
                <Button Content="Git Pull (Fast-Forward)" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 6" Command="{Binding GitPullLocalRepoCommand}" />
              </WrapPanel>
              <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="7" Padding="10">
                <TextBlock Text="{Binding LocalGitStatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
