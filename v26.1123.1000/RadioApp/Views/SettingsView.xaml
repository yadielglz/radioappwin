<UserControl x:Class="RadioApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RadioApp.Models;assembly=RadioApp.Core">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="226" />
      <ColumnDefinition Width="14" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- LEFT RAIL SETTINGS NAVIGATION -->
    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0 0 0 12">
          <TextBlock Text="STUDIO SETTINGS" FontSize="14" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryGlowBrush}" />
          <TextBlock Text="All changes save &amp; apply live" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0 2 0 0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0 10 0 0">
          <Button Content="Refresh Audio Devices" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 0 6" Command="{Binding RefreshAudioDevicesCommand}" />
          <Button Content="Open Diagnostics Logs" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenLogsFolderCommand}" />
        </StackPanel>

        <ListBox x:Name="SectionNavList" SelectedIndex="{Binding SelectedSettingsSectionIndex, Mode=TwoWay}">
          <ListBox.ItemContainerStyle>
            <Style TargetType="{x:Type ListBoxItem}">
              <Setter Property="Padding" Value="12 10" />
              <Setter Property="Margin" Value="0 0 0 4" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelCardBrush}" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#0C3152" />
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryGlowBrush}" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBoxItem Content="General &amp; System" />
          <ListBoxItem Content="Transitions &amp; AutoMix" />
          <ListBoxItem Content="Audio Routing &amp; DSP" />
          <ListBoxItem Content="Auto-DJ &amp; Automation" />
          <ListBoxItem Content="Broadcast &amp; Streaming" />
          <ListBoxItem Content="Library &amp; Maintenance" />
          <ListBoxItem Content="Cloud PC &amp; Git Updates" />
        </ListBox>
      </DockPanel>
    </Border>

    <!-- RIGHT CONTENT PANE -->
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <Grid>
        <!-- SECTION 0: GENERAL & SYSTEM -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSectionIndex}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <GroupBox Header="Startup &amp; Session Continuity">
            <StackPanel>
              <CheckBox Content="Connect and publish live broadcast stream automatically on startup" IsChecked="{Binding AutoConnectStreamOnStartup, Mode=TwoWay}" Margin="0 0 0 10" />
              <CheckBox Content="Restore saved playout queue automatically on startup" IsChecked="{Binding RestoreQueueOnStartup, Mode=TwoWay}" Margin="0 0 0 10" />
              <CheckBox Content="Start minimized to Windows system tray" IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}" />
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Windows System Tray">
            <StackPanel>
              <CheckBox Content="Minimize to tray instead of keeping taskbar button" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" Margin="0 0 0 10" />
              <CheckBox Content="Close button (X) keeps RadioApp running in tray until File → Exit" IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Configuration Backup &amp; Diagnostics">
            <WrapPanel>
              <Button Content="Export Settings Backup..." Style="{StaticResource PrimaryActionButtonStyle}" Margin="0 0 8 8" Command="{Binding ExportSettingsCommand}" />
              <Button Content="Import Settings Backup..." Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 8" Command="{Binding ImportSettingsCommand}" />
              <Button Content="Open Rotating Logs Folder" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 8" Command="{Binding OpenLogsFolderCommand}" />
            </WrapPanel>
          </GroupBox>
        </StackPanel>

        <!-- SECTION 1: TRANSITIONS & AUTOMIX (APPLE MUSIC-GRADE ENGINE) -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSectionIndex}" Value="1">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <GroupBox Header="AutoMix &amp; Gapless Transition Engine">
            <StackPanel>
              <CheckBox Content="Enable Gapless &amp; Smart Transition Engine" IsChecked="{Binding GaplessPlaybackEnabled, Mode=TwoWay}" Margin="0 0 0 14" />

              <Grid Margin="0 0 0 12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Transition Mode:" Style="{StaticResource LabelStyle}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding TransitionModeOptions}" SelectedItem="{Binding TransitionMode, Mode=TwoWay}" />
              </Grid>

              <Grid Margin="0 0 0 12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Crossfade Curve / EQ:" Style="{StaticResource LabelStyle}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding CrossfadeCurveOptions}" SelectedItem="{Binding CrossfadeCurve, Mode=TwoWay}" />
              </Grid>

              <CheckBox Content="Enable 4th-Order Linkwitz-Riley Bass-Swap EQ during transitions (prevents kick/bass mud)" IsChecked="{Binding AutoMixBassSwapEnabled, Mode=TwoWay}" Margin="0 4 0 12" />

              <Grid Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="74" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="AutoMix Beat-Sync Tolerance:" Style="{StaticResource LabelStyle}" />
                <Slider Grid.Column="1" Minimum="0" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding AutoMixMaxTempoStretchPercent, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource PrimaryGlowBrush}" Text="{Binding AutoMixMaxTempoStretchPercent, StringFormat='±{0:0.0}%'}" />
              </Grid>

              <Grid Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="74" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Bass-Swap Crossover Freq:" Style="{StaticResource LabelStyle}" />
                <Slider Grid.Column="1" Minimum="80" Maximum="350" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding AutoMixBassSwapHz, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource PrimaryGlowBrush}" Text="{Binding AutoMixBassSwapHz, StringFormat='{}{0:0} Hz'}" />
              </Grid>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Timing &amp; Category Transition Matrix">
            <StackPanel>
              <Grid Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="74" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Manual 'Mix Next' Crossfade:" Style="{StaticResource LabelStyle}" />
                <Slider Grid.Column="1" Minimum="100" Maximum="3000" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding ManualSkipCrossfadeMs, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource PrimaryGlowBrush}" Text="{Binding ManualSkipCrossfadeMs, StringFormat='{}{0} ms'}" />
              </Grid>

              <Grid Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="74" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Classic Crossfade Duration:" Style="{StaticResource LabelStyle}" />
                <Slider Grid.Column="1" Minimum="500" Maximum="12000" TickFrequency="250" IsSnapToTickEnabled="True" Value="{Binding ClassicCrossfadeMs, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource PrimaryGlowBrush}" Text="{Binding ClassicCrossfadeMs, StringFormat='{}{0} ms'}" />
              </Grid>

              <Grid Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="74" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Commercial Spot Tight Segue:" Style="{StaticResource LabelStyle}" />
                <Slider Grid.Column="1" Minimum="0" Maximum="500" TickFrequency="25" IsSnapToTickEnabled="True" Value="{Binding CommercialGaplessMs, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource PrimaryGlowBrush}" Text="{Binding CommercialGaplessMs, StringFormat='{}{0} ms'}" />
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="74" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Silence Trim Floor:" Style="{StaticResource LabelStyle}" />
                <Slider Grid.Column="1" Minimum="-66" Maximum="-24" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding GaplessSilenceThresholdDb, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource PrimaryGlowBrush}" Text="{Binding GaplessSilenceThresholdDb, StringFormat='{}{0:0} dB'}" />
              </Grid>
            </StackPanel>
          </GroupBox>
        </StackPanel>

        <!-- SECTION 2: AUDIO ROUTING & BROADCAST DSP -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSectionIndex}" Value="2">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <GroupBox Header="Audio Hardware Routing (Live Hot-Swap)">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Master Playout Output:" Style="{StaticResource LabelStyle}" Margin="0 0 10 10" />
              <ComboBox Grid.Row="0" Grid.Column="1" DisplayMemberPath="DisplayName" SelectedValuePath="DeviceNumber" ItemsSource="{Binding OutputAudioDevices}" SelectedValue="{Binding SelectedOutputDeviceNumber, Mode=TwoWay}" Margin="0 0 8 10" />
              <Button Grid.Row="0" Grid.Column="2" Content="Test Tone" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 0 10" Command="{Binding TestAudioOutputCommand}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="PFL / Audition Cue Device:" Style="{StaticResource LabelStyle}" Margin="0 0 10 10" />
              <ComboBox Grid.Row="1" Grid.Column="1" DisplayMemberPath="DisplayName" SelectedValuePath="DeviceNumber" ItemsSource="{Binding OutputAudioDevices}" SelectedValue="{Binding SelectedPflOutputDeviceNumber, Mode=TwoWay}" Margin="0 0 8 10" />
              <Button Grid.Row="1" Grid.Column="2" Content="Test PFL" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 0 10" Command="{Binding TestPflOutputCommand}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Microphone / Talk-Over Input:" Style="{StaticResource LabelStyle}" Margin="0 0 10 10" />
              <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" DisplayMemberPath="DisplayName" SelectedValuePath="DeviceNumber" ItemsSource="{Binding InputAudioDevices}" SelectedValue="{Binding SelectedInputDeviceNumber, Mode=TwoWay}" Margin="0 0 0 10" />

              <TextBlock Grid.Row="3" Grid.Column="0" Text="Mic Talk-Over Music Duck:" Style="{StaticResource LabelStyle}" />
              <Slider Grid.Row="3" Grid.Column="1" Minimum="-24" Maximum="-3" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MicDuckDb, Mode=TwoWay}" Margin="0 0 8 0" />
              <TextBlock Grid.Row="3" Grid.Column="2" FontFamily="Consolas" Foreground="{StaticResource PrimaryGlowBrush}" VerticalAlignment="Center" Text="{Binding MicDuckDb, StringFormat='{}{0:0} dB'}" />
            </Grid>
          </GroupBox>

          <GroupBox Header="EBU R128 Loudness Normalization &amp; Lookahead True-Peak Limiter">
            <StackPanel>
              <CheckBox Content="Enable EBU R128 integrated loudness matching (constant per-track gain, zero AGC pumping)" IsChecked="{Binding AudioNormalizationEnabled, Mode=TwoWay}" Margin="0 0 0 12" />

              <Grid Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="190" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Target Loudness (LUFS):" Style="{StaticResource LabelStyle}" />
                <Slider Grid.Column="1" Minimum="-24" Maximum="-6" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding NormalizationTargetDb, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource LiveGreenGlowBrush}" Text="{Binding NormalizationTargetDb, StringFormat='{}{0:0.0} LUFS'}" />
              </Grid>

              <Grid Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="190" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Max ReplayGain Boost:" Style="{StaticResource LabelStyle}" />
                <Slider Grid.Column="1" Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding NormalizationMaxGainDb, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource PrimaryGlowBrush}" Text="{Binding NormalizationMaxGainDb, StringFormat='+{0:0} dB'}" />
              </Grid>

              <CheckBox Content="Enable 5ms Lookahead True-Peak Brickwall Safety Limiter" IsChecked="{Binding AudioLimiterEnabled, Mode=TwoWay}" Margin="0 6 0 10" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="190" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="True-Peak Ceiling:" Style="{StaticResource LabelStyle}" />
                <Slider Grid.Column="1" Minimum="-6" Maximum="-0.1" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding TruePeakCeilingDb, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource WarningAmberBrush}" Text="{Binding TruePeakCeilingDb, StringFormat='{}{0:0.0} dBTP'}" />
              </Grid>
            </StackPanel>
          </GroupBox>
        </StackPanel>

        <!-- SECTION 3: AUTO-DJ, ROTATION CLOCKS, WATCHDOG & NOW PLAYING -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSectionIndex}" Value="3">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <GroupBox Header="Auto-DJ &amp; Anti-Repeat Separation">
            <StackPanel>
              <CheckBox Content="Enable continuous Auto-DJ automation" IsChecked="{Binding AutoScheduleEnabled, Mode=TwoWay}" Margin="0 0 0 8" />
              <CheckBox Content="Auto-fill remaining broadcast hour" IsChecked="{Binding AutoDjFillCurrentHour, Mode=TwoWay}" Margin="0 0 0 12" />
              <WrapPanel Margin="0 0 0 10">
                <TextBlock Text="Queue Depth:" Style="{StaticResource LabelStyle}" />
                <TextBox Width="56" Text="{Binding AutoDjQueueDepth, Mode=TwoWay}" Margin="0 0 16 0" />
                <TextBlock Text="Artist Sep (min):" Style="{StaticResource LabelStyle}" />
                <TextBox Width="56" Text="{Binding AutoDjArtistSeparationMinutes, Mode=TwoWay}" Margin="0 0 16 0" />
                <TextBlock Text="Track Sep (hrs):" Style="{StaticResource LabelStyle}" />
                <TextBox Width="56" Text="{Binding AutoDjTrackSeparationHours, Mode=TwoWay}" Margin="0 0 16 0" />
                <TextBlock Text="Ad Every N Songs:" Style="{StaticResource LabelStyle}" />
                <TextBox Width="56" Text="{Binding AutoDjCommercialIntervalSongs, Mode=TwoWay}" />
              </WrapPanel>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Hourly Tag Rotation Rules (Restored &amp; Visual)">
            <StackPanel>
              <Grid Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Default Rotation Tag:" Style="{StaticResource LabelStyle}" />
                <TextBox Grid.Column="1" Text="{Binding AutoDjDefaultTag, Mode=TwoWay}" ToolTip="Leave blank for unrestricted music rotation" />
              </Grid>

              <DataGrid ItemsSource="{Binding HourlyTagRules}" Height="130" Margin="0 0 0 8">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Start (HH:mm)" Width="120" Binding="{Binding StartTime, Mode=TwoWay}" />
                  <DataGridTextColumn Header="End (HH:mm)" Width="120" Binding="{Binding EndTime, Mode=TwoWay}" />
                  <DataGridTextColumn Header="Rotation Tag" Width="*" Binding="{Binding Tag, Mode=TwoWay}" />
                  <DataGridTemplateColumn Header="" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Content="Remove" Style="{StaticResource DangerButtonStyle}" MinHeight="22" Padding="6 1" FontSize="10"
                                Command="{Binding DataContext.RemoveHourlyRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>

              <StackPanel Orientation="Horizontal">
                <Button Content="+ Add Time Block" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 0" Command="{Binding AddHourlyRuleCommand}" />
                <Button Content="Save Rotation Schedule" Style="{StaticResource PrimaryActionButtonStyle}" Command="{Binding SaveHourlyRulesCommand}" />
              </StackPanel>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Sweepers, Station IDs &amp; Top-of-Hour Sync">
            <StackPanel>
              <WrapPanel Margin="0 0 0 8">
                <CheckBox Content="Auto Sweepers" IsChecked="{Binding SweepersEnabled, Mode=TwoWay}" Margin="0 0 12 0" />
                <Button Content="Sweeper Folder..." Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 12 0" Command="{Binding SelectSweeperFolderCommand}" />
                <TextBlock Text="Every" Style="{StaticResource LabelStyle}" />
                <TextBox Width="44" Text="{Binding SweeperMinSongs, Mode=TwoWay}" Margin="0 0 6 0" />
                <TextBlock Text="to" Style="{StaticResource LabelStyle}" />
                <TextBox Width="44" Text="{Binding SweeperMaxSongs, Mode=TwoWay}" Margin="0 0 6 0" />
                <TextBlock Text="songs" Style="{StaticResource LabelStyle}" />
              </WrapPanel>
              <TextBox IsReadOnly="True" Text="{Binding SweeperFolder}" Margin="0 0 0 12" />

              <WrapPanel Margin="0 0 0 8">
                <CheckBox Content="Timed Station IDs" IsChecked="{Binding RadioIdsEnabled, Mode=TwoWay}" Margin="0 0 12 0" />
                <Button Content="ID Folder..." Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 12 0" Command="{Binding SelectRadioIdFolderCommand}" />
                <TextBlock Text="Minute :" Style="{StaticResource LabelStyle}" />
                <TextBox Width="44" Text="{Binding RadioIdMinute, Mode=TwoWay}" Margin="0 0 10 0" />
                <CheckBox Content="Top-of-Hour Hard Sync at min:" IsChecked="{Binding TopOfHourSyncEnabled, Mode=TwoWay}" Margin="0 0 6 0" />
                <TextBox Width="44" Text="{Binding TopOfHourTargetMinute, Mode=TwoWay}" />
              </WrapPanel>
              <TextBox IsReadOnly="True" Text="{Binding RadioIdFolder}" />
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Audio-Level Dead-Air Watchdog &amp; Local Now Playing Export">
            <StackPanel>
              <CheckBox Content="Enable Dead-Air Watchdog (monitors true RMS audio silence + transport stalls)" IsChecked="{Binding SilenceWatchdogEnabled, Mode=TwoWay}" Margin="0 0 0 8" />
              <WrapPanel Margin="0 0 0 12">
                <TextBlock Text="Timeout (sec):" Style="{StaticResource LabelStyle}" />
                <TextBox Width="52" Text="{Binding SilenceWatchdogTimeoutSeconds, Mode=TwoWay}" Margin="0 0 14 0" />
                <TextBlock Text="Silence Floor (dBFS):" Style="{StaticResource LabelStyle}" />
                <TextBox Width="58" Text="{Binding SilenceWatchdogThresholdDb, Mode=TwoWay}" Margin="0 0 14 0" />
              </WrapPanel>

              <CheckBox Content="Write current track to local text file (OBS, RDS, stream overlays)" IsChecked="{Binding NowPlayingFileExportEnabled, Mode=TwoWay}" Margin="0 0 0 8" />
              <Grid Margin="0 0 0 8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="File Path:" Style="{StaticResource LabelStyle}" />
                <TextBox Grid.Column="1" Text="{Binding NowPlayingFilePath, Mode=TwoWay}" ToolTip="Blank = %APPDATA%\RadioApp\nowplaying.txt" />
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Format:" Style="{StaticResource LabelStyle}" />
                <TextBox Grid.Column="1" Text="{Binding NowPlayingFormat, Mode=TwoWay}" ToolTip="Tokens: {artist}, {title}, {album}, {category}, {duration}" />
              </Grid>
            </StackPanel>
          </GroupBox>
        </StackPanel>

        <!-- SECTION 4: BROADCAST & STREAMING -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSectionIndex}" Value="4">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <GroupBox Header="Icecast / SHOUTcast Source Encoder">
            <StackPanel>
              <UniformGrid Columns="3" Margin="0 0 0 12">
                <StackPanel Margin="0 0 8 0">
                  <TextBlock Text="Protocol" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding StreamConfig.ServerType, Mode=TwoWay}">
                    <ComboBoxItem Content="Icecast 2" Tag="{x:Static models:StreamServerType.Icecast}" />
                    <ComboBoxItem Content="SHOUTcast v1/v2" Tag="{x:Static models:StreamServerType.Shoutcast}" />
                  </ComboBox>
                </StackPanel>
                <StackPanel Margin="0 0 8 0">
                  <TextBlock Text="Host Address" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding StreamConfig.Host, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Port" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding StreamConfig.Port, Mode=TwoWay}" />
                </StackPanel>
              </UniformGrid>

              <UniformGrid Columns="3" Margin="0 0 0 12">
                <StackPanel Margin="0 0 8 0">
                  <TextBlock Text="Mount Point (Icecast)" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding StreamConfig.Mount, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Margin="0 0 8 0">
                  <TextBlock Text="Username" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding StreamConfig.Username, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel>
                  <DockPanel Margin="0 0 0 4">
                    <TextBlock Text="Source Password (DPAPI)" Style="{StaticResource LabelStyle}" />
                    <CheckBox x:Name="ShowPasswordToggle" DockPanel.Dock="Right" Content="Show" FontSize="11" Checked="ShowPassword_Changed" Unchecked="ShowPassword_Changed" />
                  </DockPanel>
                  <PasswordBox x:Name="StreamPasswordBox" PasswordChanged="StreamPasswordBox_PasswordChanged" />
                  <TextBox x:Name="StreamPasswordPlainBox" Visibility="Collapsed" Text="{Binding StreamConfig.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </UniformGrid>

              <UniformGrid Columns="3" Margin="0 0 0 12">
                <StackPanel Margin="0 0 8 0">
                  <TextBlock Text="MP3 Bitrate (kbps)" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding StreamConfig.Bitrate, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Margin="0 0 8 0">
                  <TextBlock Text="SHOUTcast Stream ID" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding StreamConfig.ShoutcastStreamId, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom">
                  <CheckBox Content="Auto-reconnect on drop" IsChecked="{Binding StreamConfig.AutoReconnectEnabled, Mode=TwoWay}" Margin="0 0 0 6" />
                </StackPanel>
              </UniformGrid>

              <WrapPanel Margin="0 4 0 10">
                <Button Content="Connect &amp; Go Live" Style="{StaticResource LiveActionButtonStyle}" Margin="0 0 8 0" Command="{Binding ConnectStreamCommand}" />
                <Button Content="Disconnect" Style="{StaticResource DangerButtonStyle}" Margin="0 0 8 0" Command="{Binding DisconnectStreamCommand}" />
                <Button Content="Test TCP Connection" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding TestStreamConnectionCommand}" />
              </WrapPanel>

              <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="7" Padding="10">
                <StackPanel>
                  <TextBlock Text="{Binding StreamStatus}" FontWeight="Bold" Foreground="{StaticResource PrimaryGlowBrush}" />
                  <TextBlock Text="{Binding StreamEndpointText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0 2 0 0" />
                  <TextBlock Text="{Binding StreamTestStatus}" FontSize="11" Foreground="{StaticResource LiveGreenGlowBrush}" Margin="0 4 0 0"
                             Visibility="{Binding StreamTestStatus, Converter={StaticResource NullToVisibilityConverter}}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Station Directory Headers &amp; Live ICY Song Metadata">
            <StackPanel>
              <UniformGrid Columns="2" Margin="0 0 0 10">
                <StackPanel Margin="0 0 8 0">
                  <TextBlock Text="Station Name" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding StreamConfig.StationName, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Genre" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding StreamConfig.StationGenre, Mode=TwoWay}" />
                </StackPanel>
              </UniformGrid>
              <UniformGrid Columns="2" Margin="0 0 0 10">
                <StackPanel Margin="0 0 8 0">
                  <TextBlock Text="Station Website URL" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding StreamConfig.StationUrl, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Live Metadata Template" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding StreamConfig.MetadataFormat, Mode=TwoWay}" />
                </StackPanel>
              </UniformGrid>
              <CheckBox Content="Automatically push Artist - Title metadata updates to Icecast / SHOUTcast on every track change"
                        IsChecked="{Binding StreamConfig.PushTrackMetadata, Mode=TwoWay}" />
            </StackPanel>
          </GroupBox>
        </StackPanel>

        <!-- SECTION 5: LIBRARY, ANALYZER & MAINTENANCE -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSectionIndex}" Value="5">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <GroupBox Header="Watched Library Folders &amp; Background AutoMix Analyzer">
            <StackPanel>
              <CheckBox Content="Watch library folders automatically for new, modified, or removed audio files" IsChecked="{Binding Library.BackgroundRefreshEnabled, Mode=TwoWay}" Margin="0 0 0 8" />
              <CheckBox Content="Automatically analyze new tracks in background (EBU R128 LUFS, BPM, Beat Grid, Cues, Waveform)" IsChecked="{Binding AutoAnalyzeLibraryInBackground, Mode=TwoWay}" Margin="0 0 0 10" />
              <WrapPanel Margin="0 0 0 8">
                <Button Content="+ Add Folder" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0 0 6 0" Command="{Binding Library.AddWatchedFolderCommand}" />
                <Button Content="Remove Folder" Style="{StaticResource DangerButtonStyle}" Margin="0 0 6 0" Command="{Binding Library.RemoveWatchedFolderCommand}" />
                <Button Content="Rescan Now" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 6 0" Command="{Binding Library.RescanWatchedFoldersCommand}" />
                <Button Content="Analyze Unanalyzed Tracks" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Library.AnalyzeAllUnanalyzedCommand}" />
              </WrapPanel>
              <ListBox Height="120" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                       ItemsSource="{Binding Library.WatchedFolders}" SelectedItem="{Binding Library.SelectedWatchedFolder, Mode=TwoWay}" />
              <TextBlock Text="{Binding Library.AnalysisStatus}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0 6 0 0" />
            </StackPanel>
          </GroupBox>

          <GroupBox Header="SQLite Database Health &amp; Factory Reset">
            <WrapPanel>
              <Button Content="Backup Database..." Style="{StaticResource PrimaryActionButtonStyle}" Margin="0 0 8 8" Command="{Binding BackupDatabaseCommand}" />
              <Button Content="Verify DB Integrity" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 8" Command="{Binding VerifyDatabaseCommand}" />
              <Button Content="Remove Missing Tracks" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 8" Command="{Binding Library.RemoveMissingFilesCommand}" />
              <Button Content="Clear Library DB" Style="{StaticResource DangerButtonStyle}" Margin="0 0 8 8" Command="{Binding ClearLibraryCommand}" />
              <Button Content="Factory Reset All Settings" Style="{StaticResource DangerButtonStyle}" Margin="0 0 8 8" Command="{Binding ResetAppCommand}" />
            </WrapPanel>
          </GroupBox>
        </StackPanel>

        <!-- SECTION 6: CLOUD PC & GIT UPDATES -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSectionIndex}" Value="6">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <GroupBox Header="Cloud PC &amp; Unattended RDP Broadcast Continuity">
            <StackPanel>
              <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushMedium}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0 0 0 12">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Switch to Headless Clock Now" Style="{StaticResource SecondaryButtonStyle}"
                          Command="{Binding SwitchToHeadlessClockNowCommand}" VerticalAlignment="Center" Margin="12 0 0 0" />
                  <StackPanel>
                    <TextBlock Text="ACTIVE AUDIO CLOCK ENGINE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding ActiveAudioClockText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryGlowBrush}" Margin="0 3 0 0" TextWrapping="Wrap" />
                    <TextBlock Text="When an RDP session disconnects and Windows removes Remote Audio, RadioApp seamlessly hot-swaps to its internal 44.1 kHz Headless Broadcast Clock so AutoMix, DSP, Scheduler, and Icecast/SHOUTcast streaming never drop a beat."
                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0 4 0 0" />
                  </StackPanel>
                </DockPanel>
              </Border>

              <CheckBox Content="Enable Cloud PC Unattended Mode (master switch for RDP-safe failover &amp; keep-awake)"
                        IsChecked="{Binding CloudUnattendedModeEnabled, Mode=TwoWay}" Margin="0 0 0 10" />
              <CheckBox Content="Automatically hot-swap to Headless Broadcast Clock on RDP disconnect or soundcard loss"
                        IsChecked="{Binding AutoFallbackToHeadlessClock, Mode=TwoWay}" Margin="0 0 0 10" />
              <CheckBox Content="Prevent Windows Cloud PC from sleeping or suspending broadcast threads (SetThreadExecutionState)"
                        IsChecked="{Binding KeepSystemAwakeWhileRunning, Mode=TwoWay}" Margin="0 0 0 10" />
              <CheckBox Content="Elevate process priority to Above Normal to prevent background CPU throttling"
                        IsChecked="{Binding ElevateProcessPriority, Mode=TwoWay}" Margin="0 0 0 10" />
              <CheckBox Content="Automatically start playout on startup (for unattended Cloud PC reboots)"
                        IsChecked="{Binding AutoStartPlaybackOnStartup, Mode=TwoWay}" Margin="0 0 0 10" />
              <CheckBox Content="Launch RadioApp Studio automatically when Windows signs in (HKCU Run)"
                        IsChecked="{Binding LaunchOnWindowsLogin, Mode=TwoWay}" />
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Fetch &amp; Install Updates from GitHub Releases">
            <StackPanel>
              <UniformGrid Columns="2" Margin="0 0 0 10">
                <StackPanel Margin="0 0 10 0">
                  <TextBlock Text="GitHub Repository (owner/repo)" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                  <TextBox Text="{Binding GitUpdateRepository, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom">
                  <CheckBox Content="Check for GitHub updates automatically on startup"
                            IsChecked="{Binding AutoCheckForUpdatesOnStartup, Mode=TwoWay}" Margin="0 0 0 6" />
                </StackPanel>
              </UniformGrid>

              <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0 0 0 10">
                <StackPanel>
                  <UniformGrid Columns="2" Margin="0 0 0 6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Installed: " Style="{StaticResource LabelStyle}" />
                      <TextBlock Text="{Binding AppVersionText}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Latest on GitHub: " Style="{StaticResource LabelStyle}" />
                      <TextBlock Text="{Binding LatestRemoteVersionText}" FontWeight="Bold" Foreground="{StaticResource LiveGreenGlowBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                  </UniformGrid>

                  <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" Foreground="{StaticResource PrimaryGlowBrush}" TextWrapping="Wrap" Margin="0 2 0 0" />

                  <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding UpdateDownloadPercent, Mode=OneWay}"
                               Foreground="{StaticResource LiveGreenBrush}" Background="{StaticResource PanelCardBrush}" BorderThickness="0"
                               Margin="0 8 0 0"
                               Visibility="{Binding IsCheckingOrDownloadingUpdate, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
              </Border>

              <WrapPanel Margin="0 0 0 10">
                <Button Content="Check GitHub for Updates" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0 0 8 8" Command="{Binding CheckForUpdatesCommand}" />
                <Button Content="Download &amp; Install MSI Update" Style="{StaticResource LiveActionButtonStyle}" Margin="0 0 8 8" Command="{Binding DownloadAndInstallMsiUpdateCommand}" />
                <Button Content="Download &amp; Apply Portable ZIP" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 8" Command="{Binding DownloadAndInstallZipUpdateCommand}" />
                <Button Content="Open Release Page" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 8" Command="{Binding OpenReleasePageCommand}" />
              </WrapPanel>

              <TextBlock Text="Release Notes" Style="{StaticResource LabelStyle}" Margin="0 0 0 4"
                         Visibility="{Binding UpdateReleaseNotes, Converter={StaticResource NullToVisibilityConverter}}" />
              <TextBox Text="{Binding UpdateReleaseNotes, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Height="110" Padding="10 8"
                       Visibility="{Binding UpdateReleaseNotes, Converter={StaticResource NullToVisibilityConverter}}" />
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Direct Local Git Repository Sync (git fetch / git pull)">
            <StackPanel>
              <TextBlock Text="Optional: point to a local git clone of this repository to fetch or fast-forward pull commits directly from the Cloud PC."
                         FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0 0 0 10" />
              <DockPanel Margin="0 0 0 10">
                <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource SecondaryButtonStyle}" Margin="8 0 0 0" Command="{Binding BrowseLocalGitRepoCommand}" />
                <TextBox Text="{Binding LocalGitRepoPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Leave empty to auto-detect from application folder" />
              </DockPanel>
              <WrapPanel Margin="0 0 0 8">
                <Button Content="Git Fetch &amp; Check Status" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0 0 8 6" Command="{Binding GitFetchLocalRepoCommand}" />
                <Button Content="Git Pull (Fast-Forward)" Style="{StaticResource SecondaryButtonStyle}" Margin="0 0 8 6" Command="{Binding GitPullLocalRepoCommand}" />
              </WrapPanel>
              <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="7" Padding="10">
                <TextBlock Text="{Binding LocalGitStatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
