<Window x:Class="RadioApp.Views.PlaysetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Playset Editor — RadioApp Studio"
        Width="580" SizeToContent="Height" MaxHeight="760" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="14 10" Margin="0 0 0 14">
      <StackPanel>
        <TextBlock Text="PLAYSET CONFIGURATION" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryGlowBrush}" />
        <TextBlock Text="Create a curated Manual Playset or a dynamic Smart Rule Playset" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0 2 0 0" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Grid Margin="0 0 0 12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Playset Name" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
            <TextBox Text="{Binding Playset.Name, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Accent Color" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Playset.AccentColor, Mode=TwoWay}">
              <ComboBoxItem Content="Broadcast Blue" Tag="#0284C7" />
              <ComboBoxItem Content="AutoMix Violet" Tag="#8B5CF6" />
              <ComboBoxItem Content="Studio Emerald" Tag="#10B981" />
              <ComboBoxItem Content="Prime Amber" Tag="#F59E0B" />
              <ComboBoxItem Content="Hot Crimson" Tag="#EF4444" />
              <ComboBoxItem Content="Cyan Pulse" Tag="#06B6D4" />
            </ComboBox>
          </StackPanel>
        </Grid>

        <TextBlock Text="Description" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
        <TextBox Text="{Binding Playset.Description, Mode=TwoWay}" Margin="0 0 0 12" />

        <Grid Margin="0 0 0 14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Playset Type" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
            <ComboBox x:Name="KindComboBox" SelectedItem="{Binding Playset.Kind, Mode=TwoWay}" SelectionChanged="KindComboBox_SelectionChanged" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Transition Override" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
            <ComboBox x:Name="TransitionOverrideComboBox" />
          </StackPanel>
        </Grid>

        <!-- Smart Rule Panel -->
        <GroupBox x:Name="SmartRulesGroup" Header="Smart Playset Filter Rules">
          <StackPanel>
            <Grid Margin="0 0 0 10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Category Filter" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                <ComboBox x:Name="RuleCategoryComboBox" IsEditable="True" Text="{Binding Rule.CategoryFilter, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Sort Order" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Rule.SortBy, Mode=TwoWay}">
                  <ComboBoxItem Content="Title (A-Z)" Tag="Title" />
                  <ComboBoxItem Content="Artist (A-Z)" Tag="Artist" />
                  <ComboBoxItem Content="BPM Ascending (DJ Flow)" Tag="Bpm" />
                  <ComboBoxItem Content="Newest Added" Tag="DateAddedDesc" />
                  <ComboBoxItem Content="Least Played" Tag="LeastPlayed" />
                  <ComboBoxItem Content="Shuffled Random" Tag="Random" />
                </ComboBox>
              </StackPanel>
            </Grid>

            <Grid Margin="0 0 0 10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Required Tags (ALL, comma-sep)" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                <TextBox Text="{Binding Rule.RequiredTags, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Any Tags (OR, comma-sep)" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                <TextBox Text="{Binding Rule.AnyTags, Mode=TwoWay}" />
              </StackPanel>
            </Grid>

            <Grid Margin="0 0 0 10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Min BPM" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                <TextBox x:Name="MinBpmBox" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Max BPM" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                <TextBox x:Name="MaxBpmBox" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Max Tracks" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
                <TextBox Text="{Binding Rule.MaxTracks, Mode=TwoWay}" />
              </StackPanel>
            </Grid>

            <TextBlock Text="Folder Path Contains (optional)" Style="{StaticResource LabelStyle}" Margin="0 0 0 4" />
            <TextBox Text="{Binding Rule.FolderContains, Mode=TwoWay}" Margin="0 0 0 10" />

            <CheckBox Content="Only include tracks that have never been played" IsChecked="{Binding Rule.OnlyNeverPlayed, Mode=TwoWay}" />
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 14 0 0">
      <Button Content="Save Playset" Style="{StaticResource PrimaryActionButtonStyle}" Width="120" Margin="0 0 8 0" Click="Save_Click" />
      <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="90" Click="Cancel_Click" />
    </StackPanel>
  </Grid>
</Window>
