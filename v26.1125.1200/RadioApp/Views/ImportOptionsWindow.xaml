<Window x:Class="RadioApp.Views.ImportOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Profile — RadioApp Studio"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="14 10" Margin="0 0 0 16">
      <StackPanel>
        <TextBlock Text="TRACK IMPORT PROFILE" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryGlowBrush}" />
        <TextBlock Text="Configure default category, tags, and background AutoMix analysis" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0 2 0 0" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="1">
      <TextBlock Text="Target Category" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 0 0 6" />
      <ComboBox x:Name="CategoryComboBox" IsEditable="True" Text="{Binding Options.Category, Mode=TwoWay}" Margin="0 0 0 14">
        <ComboBoxItem Content="Music" />
        <ComboBoxItem Content="Sweeper" />
        <ComboBoxItem Content="StationId" />
        <ComboBoxItem Content="Commercial" />
        <ComboBoxItem Content="VoiceTrack" />
        <ComboBoxItem Content="Jingle" />
        <ComboBoxItem Content="Promo" />
        <ComboBoxItem Content="Uncategorized" />
      </ComboBox>

      <TextBlock Text="Default Tags (comma separated)" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 0 0 6" />
      <TextBox Text="{Binding Options.Tags, Mode=TwoWay}" Margin="0 0 0 14" />

      <CheckBox Content="Auto-detect category from folder / filename" IsChecked="{Binding Options.UseInferredCategory, Mode=TwoWay}" Margin="0 0 0 10" />
      <CheckBox Content="Analyze BPM, LUFS loudness, cues &amp; waveform in background" IsChecked="{Binding Options.AnalyzeAfterImport, Mode=TwoWay}" />
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 20 0 0">
      <Button Content="Start Import" Style="{StaticResource PrimaryActionButtonStyle}" Width="120" Margin="0 0 8 0" Click="Import_Click" />
      <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="90" Click="Cancel_Click" />
    </StackPanel>
  </Grid>
</Window>
