<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RadioApp.Views.ScheduleEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:RadioApp.Models" Title="Edit Schedule Event" Height="560" Width="600" MinHeight="520" MinWidth="580" ResizeMode="CanResizeWithGrip" xmlns:views="clr-namespace:RadioApp.Views">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
      <TextBlock Text="Title:" Width="120" VerticalAlignment="Center" />
      <TextBox Width="340" Text="{Binding ScheduleItem.Title, Mode=TwoWay}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0 0 0 8">
      <TextBlock Text="Event Type:" Width="120" VerticalAlignment="Center" />
      <ComboBox Name="EventTypeComboBox" Width="240" SelectedItem="{Binding ScheduleItem.EventType, Mode=TwoWay}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0 0 0 8">
      <TextBlock Text="Target Deck:" Width="120" VerticalAlignment="Center" />
      <ComboBox Name="TargetDeckComboBox" Width="240" SelectedItem="{Binding ScheduleItem.TargetDeck, Mode=TwoWay}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0 0 0 8">
      <TextBlock Text="File / Folder:" Width="120" VerticalAlignment="Center" />
      <TextBox Width="280" Text="{Binding ScheduleItem.FilePath, Mode=TwoWay}" />
      <Button Content="Browse" Width="80" Margin="8 0 0 0" Click="BrowseFile_Click" />
      <Button Content="Folder" Width="80" Margin="8 0 0 0" Click="BrowseFolder_Click" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Grid.Row="4" Margin="0 0 0 8">
      <TextBlock Text="Date:" Width="120" VerticalAlignment="Center" />
      <DatePicker Width="150" SelectedDate="{Binding SelectedDate, Mode=TwoWay}" />
      <TextBlock Text="Time (HH:mm):" Width="120" Margin="12 0 0 0" VerticalAlignment="Center" />
      <TextBox Width="90" Text="{Binding ScheduleTime, Mode=TwoWay}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Grid.Row="5" Margin="0 0 0 8">
      <TextBlock Text="Repeat:" Width="120" VerticalAlignment="Center" />
      <ComboBox Name="RepeatModeComboBox" Width="120" SelectedItem="{Binding ScheduleItem.RepeatMode, Mode=TwoWay}" />
      <TextBlock Text="Interval min:" Width="90" Margin="12 0 0 0" VerticalAlignment="Center" />
      <TextBox Width="90" Text="{Binding RepeatMinutes, Mode=TwoWay}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Grid.Row="6" Margin="0 0 0 8">
      <TextBlock Text="Tolerance:" Width="120" VerticalAlignment="Center" />
      <TextBlock Text="Early min:" Width="70" VerticalAlignment="Center" />
      <TextBox Width="70" Text="{Binding ToleranceBeforeMinutes, Mode=TwoWay}" />
      <TextBlock Text="Late min:" Width="70" Margin="12 0 0 0" VerticalAlignment="Center" />
      <TextBox Width="70" Text="{Binding ToleranceAfterMinutes, Mode=TwoWay}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Grid.Row="7" Margin="0 0 0 12">
      <TextBlock Text="Options:" Width="120" VerticalAlignment="Center" />
      <CheckBox Content="Main program event" VerticalAlignment="Center" IsChecked="{Binding ScheduleItem.IsMain, Mode=TwoWay}" />
      <TextBlock Text="Enabled:" Width="70" Margin="18 0 0 0" VerticalAlignment="Center" />
      <CheckBox VerticalAlignment="Center" IsChecked="{Binding ScheduleItem.Enabled, Mode=TwoWay}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Grid.Row="8" Margin="0 0 0 12" VerticalAlignment="Top">
      <TextBlock Text="Folder Block:" Width="120" VerticalAlignment="Center" />
      <CheckBox Content="Use folder as random playlist source" VerticalAlignment="Center" IsChecked="{Binding ScheduleItem.IsFolderSource, Mode=TwoWay}" />
      <TextBlock Text="Minutes:" Width="64" Margin="18 0 0 0" VerticalAlignment="Center" />
      <TextBox Width="70" Text="{Binding BlockDurationMinutes, Mode=TwoWay}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Grid.Row="8" HorizontalAlignment="Right" VerticalAlignment="Bottom">
      <Button Content="Save" Width="100" Margin="0 0 8 0" Click="Save_Click" />
      <Button Content="Cancel" Width="100" Click="Cancel_Click" />
    </StackPanel>
  </Grid>
</Window>