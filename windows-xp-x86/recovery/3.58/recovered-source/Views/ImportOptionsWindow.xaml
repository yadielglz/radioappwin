<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RadioApp.Views.ImportOptionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Import Options" Height="360" Width="460" MinHeight="340" MinWidth="430" SizeToContent="Height" ResizeMode="CanResizeWithGrip" xmlns:views="clr-namespace:RadioApp.Views;assembly=RadioApp">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Import Options" FontSize="22" FontWeight="SemiBold" Margin="0 0 0 16" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <StackPanel Margin="0 0 0 12">
          <TextBlock Text="Category" Foreground="{StaticResource MutedTextBrush}" Margin="0 0 0 4" />
          <ComboBox Name="CategoryComboBox" IsEditable="True" Text="{Binding Options.Category, Mode=TwoWay}">
            <ComboBoxItem Content="Music" />
            <ComboBoxItem Content="Sweeper" />
            <ComboBoxItem Content="StationId" />
            <ComboBoxItem Content="Commercial" />
            <ComboBoxItem Content="VoiceTrack" />
            <ComboBoxItem Content="Uncategorized" />
          </ComboBox>
        </StackPanel>
        <StackPanel Margin="0 0 0 14">
          <TextBlock Text="Tags" Foreground="{StaticResource MutedTextBrush}" Margin="0 0 0 4" />
          <TextBox Text="{Binding Options.Tags, Mode=TwoWay}" />
        </StackPanel>
        <CheckBox Content="Infer category from folder/file names" Margin="0 0 0 8" IsChecked="{Binding Options.UseInferredCategory, Mode=TwoWay}" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 18 0 0">
      <Button Content="Import" Width="100" Margin="0 0 8 0" Click="Import_Click" />
      <Button Content="Cancel" Width="100" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" />
    </StackPanel>
  </Grid>
</Window>