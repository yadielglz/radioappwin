<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>Assets\RadioAppIcon.ico</ApplicationIcon>
    <Version>26.1120.1000</Version>
    <AssemblyVersion>26.1120.1000.0</AssemblyVersion>
    <FileVersion>26.1120.1000.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RadioApp.Core\RadioApp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\RadioAppIcon.ico" />
    <Resource Include="Assets\RadioAppLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>
